
{% extends 'master.html.jinja' %}
{% block home_selected %}{% endblock %}
{% block packages_selected %} pure-menu-selected{% endblock %}
{% block content %}
{% include 'bashline.html.jinja' %}
    <main class="site-main">
        <div class="content">
            <h2 class="content-head is-center text-normal">{{ package_name }}@{{ package_version }}</h2>
            <p class="content-subhead">Install:</p>
            {{ bashline("ttrek install " ~ package_name ~ "@" ~ package_version) }}
            {% if deps %}
                <p class="content-subhead">Dependencies:</p>
                <table class="pure-table" style="border: 1px solid black; border-spacing: 20px 5px;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Version Range</th>
                            <th>Condition</th>
                        </tr>
                      </thead>
                    <tbody>
                        {% for dep in deps %}
                            <tr>
                                <td><a href="/package/{{ dep.name|urlencode }}">{{ dep.name }}</a></td>
                                <td>{{ dep.version }}</td>
                                <td>{{ dep.condition }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            {% if download_platforms %}
                <p class="content-subhead">Recipe downloads by platform (all time):</p>
                <p>Recorded recipe requests for this version, including dependencies, repeat downloads, and requests without a machine ID.</p>
                <table class="pure-table">
                    <thead><tr><th scope="col">OS / architecture</th><th scope="col">Downloads</th></tr></thead>
                    <tbody>{% for row in download_platforms %}<tr><td>{{ row[0] }}</td><td>{{ row[1] }}</td></tr>{% endfor %}</tbody>
                </table>
            {% endif %}
            {% if stat_platforms %}
                <p class="content-subhead">Statistics (installations):</p>
                <table class="pure-table">
                    <thead><tr><th>Platform</th><th>Total</th><th>Success</th><th>Failure</th></tr></thead>
                    <tbody>
                        {% for stat_platform in stat_platforms %}
                            <tr>
                                <td>{{ stat_platform[0] }}</td>
                                <td>{{ stat_platform[1] }}</td>
                                <td>{{ stat_platform[2] }}</td>
                                <td>{{ stat_platform[3] }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </main>
{% endblock %}
