<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="stylesheet" href="/css/pure/pure-min.css" />
        <link rel="stylesheet" href="/css/pure/grids-responsive-min.css" />
        <link rel="stylesheet" href="/css/styles.css" />
        {% block styles %}{% endblock %}
        <title>{% if pagetitle %}{{ pagetitle }}{% else %}{{ title }} · ttrek{% endif %}</title>
    </head>
    <body>
        <div class="header">
            <div class="home-menu pure-menu pure-menu-horizontal pure-menu-fixed">
                <a class="pure-menu-heading text-normal" href="/">{% if pagetitle %}{{ pagetitle }}{% else %}ttrek{% endif %}</a>

                <ul class="pure-menu-list">
                    <li class="pure-menu-item{% block home_selected %} pure-menu-selected{% endblock %}"><a href="/" class="pure-menu-link">Home</a></li>
                    <li class="pure-menu-item{% block docs_selected %}{% endblock %}"><a href="/docs" class="pure-menu-link">Documentation</a></li>
                    <li class="pure-menu-item"><a href="#" class="pure-menu-link">Sign Up</a></li>
                </ul>
            </div>
        </div>
        {% block content %}{% endblock %}
        <div class="footer l-box is-center">
            &#169; 2024 JERILY LTD - View the source code on <a href="https://github.com/jerily/ttrek">github</a>.
        </div>
        {% block scripts %}
            <script src="/js/clipboard.min.js"></script>
            <script>new ClipboardJS(".clipboard");</script>
        {% endblock %}
    </body>
</html>
