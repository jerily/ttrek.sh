<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href="{{ asset_urls['/favicon.ico'] }}" sizes="16x16 32x32 48x48" />
        <link rel="icon" href="{{ asset_urls['/assets/favicon.svg'] }}" type="image/svg+xml" sizes="any" />
        <link rel="stylesheet" href="{{ asset_urls['/css/site.css'] }}" />
        {% block styles %}{% endblock %}
        <title>{% if pagetitle %}{{ pagetitle }}{% else %}{{ title }} · ttrek{% endif %}</title>
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <header class="site-header">
            <nav class="home-menu pure-menu pure-menu-horizontal" aria-label="Site">
                <a class="pure-menu-heading text-normal" href="/">ttrek<span class="brand-dot">.</span></a>

                <ul class="pure-menu-list">
                    <li class="pure-menu-item{% block forum_selected %}{% endblock %}"><a href="/forum" class="pure-menu-link">Forum</a></li>
                    <li class="pure-menu-item{% block packages_selected %}{% endblock %}"><a href="/packages" class="pure-menu-link">Packages</a></li>
                    <li class="pure-menu-item{% block docs_selected %}{% endblock %}"><a href="/docs" class="pure-menu-link">Docs</a></li>
                    <li class="pure-menu-item{% block blog_selected %}{% endblock %}"><a href="/blog" class="pure-menu-link">Blog</a></li>
                    <!-- ttrek-account-navigation -->
                </ul>
            </nav>
        </header>
        {% block content %}{% endblock %}
        <footer class="footer is-center">
            <p class="footer-main"><a href="https://github.com/jerily/ttrek">Source on GitHub</a> · <a href="https://github.com/jerily/ttrek-registry">Registry on GitHub</a></p>
            <nav class="footer-policies" aria-label="Policies">
                <a href="/docs/policies/cookies">Cookies</a> ·
                <a href="/docs/policies/privacy-policy">Privacy Policy</a> ·
                <a href="/docs/policies/terms-of-service">Terms of Service</a>
            </nav>
            <p class="footer-main">&#169; <!-- ttrek-current-year --> JERILY LTD</p>
        </footer>
        {% block scripts %}
            <script type="module" src="{{ asset_urls['/js/site.js'] }}"></script>
        {% endblock %}
    </body>
</html>
