<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="stylesheet" href="{{ asset_urls['/css/site.css'] }}" />
        {% block styles %}{% endblock %}
        <title>{% if pagetitle %}{{ pagetitle }}{% else %}{{ title }} · ttrek{% endif %}</title>
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <header class="site-header">
            <nav class="home-menu pure-menu pure-menu-horizontal" aria-label="Site">
                <a class="pure-menu-heading text-normal" href="/">ttrek<span class="brand-dot">.</span></a>

                <ul class="pure-menu-list">
                    <li class="pure-menu-item{% block home_selected %} pure-menu-selected{% endblock %}"><a href="/" class="pure-menu-link">Home</a></li>
                    <li class="pure-menu-item{% block packages_selected %}{% endblock %}"><a href="/packages" class="pure-menu-link">Packages</a></li>
                    <li class="pure-menu-item{% block docs_selected %}{% endblock %}"><a href="/docs" class="pure-menu-link">Documentation</a></li>
                    <li class="pure-menu-item{% block blog_selected %}{% endblock %}"><a href="/blog" class="pure-menu-link">Blog</a></li>
                </ul>
            </nav>
        </header>
        {% block content %}{% endblock %}
        <footer class="footer is-center">
            &#169; <!-- ttrek-current-year --> JERILY LTD · <a href="https://github.com/jerily/ttrek">Source on GitHub</a> · <a href="https://github.com/jerily/ttrek-registry">Registry on GitHub</a> · <a href="/request-monitor">Request Monitor</a>
        </footer>
        {% block scripts %}
            <script type="module" src="{{ asset_urls['/js/site.js'] }}"></script>
        {% endblock %}
    </body>
</html>
