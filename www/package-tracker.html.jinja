{% extends 'master.html.jinja' %}
{% block body_class %}registry-page tracker-page{% endblock %}
{% block home_selected %}{% endblock %}
{% block packages_selected %} pure-menu-selected{% endblock %}
{% block content %}
<main class="site-main registry-main">
    <a class="package-back" href="/packages">← All packages</a>
    <header class="registry-intro tracker-intro">
        <p class="eyebrow">EXPLORE THE REGISTRY</p>
        <h1>Package Tracker</h1>
        <p>New arrivals, fresh releases, and the packages people are downloading.</p>
        {% if tracker.available %}<p class="tracker-freshness{% if tracker.stale %} is-delayed{% endif %}">{% if tracker.stale %}Refresh delayed. {% endif %}Updated {{ tracker.updated }} · Refreshes every 5 minutes.</p>{% endif %}
    </header>
    <nav class="tracker-jump" aria-label="Tracker measures">
        {% for section in tracker.sections %}<a href="#{{ section.id }}">{{ section.title }}</a>{% endfor %}
    </nav>
    <div class="tracker-grid">
        <div class="tracker-column">
        {% for section in tracker.sections %}
        <section class="tracker-section" id="{{ section.id }}" aria-labelledby="heading-{{ section.id }}">
            <header><h2 id="heading-{{ section.id }}">{{ section.title }}</h2><p>{{ section.period }}</p></header>
            {% if section.rows %}
            <ol class="tracker-ranking">
                {% for package in section.rows %}
                <li><div class="tracker-row-heading"><a href="/package/{{ package.name|urlencode }}">{{ package.name }}</a><span class="version-badge">{{ package.version }}</span></div>
                    {% if package.description %}<p class="tracker-description">{{ package.description }}</p>{% endif %}
                    <p class="tracker-metric">{{ package.metric }}</p>
                    {% if section.id == 'updated' %}<a class="tracker-version-link" href="/package/{{ package.name|urlencode }}/{{ package.version|urlencode }}">View published version →</a>{% endif %}
                </li>
                {% endfor %}
            </ol>
            {% else %}<p class="tracker-empty">{{ section.empty }}</p>{% endif %}
        </section>
        {% if loop.index == 2 %}</div><div class="tracker-column">{% endif %}
        {% endfor %}
        </div>
    </div>
    <details class="tracker-methodology">
        <summary>How these measures work</summary>
        <p>New records a package’s first public registry inclusion. Recently Updated records a new version of an existing package; editing a recipe or republishing the same version does not count. Both cover the last 30 days. Each category shows up to 5 packages.</p>
        <p>Missing historical publication dates were initialized to November 15, 2026. Future publications are recorded when registry synchronization makes them available.</p>
        <p>Popular counts unique machines downloading recipes in the last 30 days, including dependencies. Each machine counts once per package across currently listed versions, architectures, and repeat requests. Requests without a registered machine ID are excluded from unique counts. Downloads do not establish successful installations or unique people.</p>
        <p>Trending compares unique machines in two consecutive 7-day windows at the same refresh cutoff. It requires at least {{ tracker.thresholds.min_current }} machines in the recent week, {{ tracker.thresholds.min_previous }} in the preceding week, {{ tracker.thresholds.min_delta }} additional machines, and {{ tracker.thresholds.min_growth }}% growth. Each machine counts once in each window, even if its environment registration changes. Rankings sort by percentage growth, then additional machines.</p>
        <p>Comparisons begin once stored recipe-request history reaches back at least 14 days. A missing baseline does not produce an infinite growth percentage. Dates and chart days use UTC. {% if tracker.since %}The earliest stored recipe request is {{ tracker.since }}.{% endif %}</p>
    </details>
</main>
{% endblock %}
