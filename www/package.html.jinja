{% extends 'master.html.jinja' %}
{% block body_class %}registry-page package-page{% endblock %}
{% block home_selected %}{% endblock %}
{% block packages_selected %} pure-menu-selected{% endblock %}
{% block content %}
{% include 'bashline.html.jinja' %}
<main class="site-main registry-main">
    <a class="package-back" href="/packages">← All packages</a>
    <header class="package-hero">
        <div class="package-icon" aria-hidden="true">{ }</div>
        <div><p class="eyebrow">PACKAGE OVERVIEW</p><h1>{{ package_name }} {% if latest_version %}<span class="version-badge">{{ latest_version }}</span>{% endif %}</h1>
            {% if description %}<p class="package-description">{{ description }}</p>{% endif %}
            {% if tags %}<ul class="package-tags" aria-label="Tags">{% for tag in tags %}<li><a href="/search?q={{ tag|urlencode }}">{{ tag }}</a></li>{% endfor %}</ul>{% endif %}
        </div>
    </header>
    <div class="package-overview-grid">
        <div class="package-primary">
            <section class="package-surface package-install"><h2>Install</h2><p>Add this package to your project.</p>{{ bashline("ttrek install " ~ package_name) }}</section>
            {% if activity.available %}
            <section class="package-surface package-activity" aria-labelledby="activity-heading">
                <div class="package-section-heading"><h2 id="activity-heading">Recipe download activity</h2><span class="period-badge">Last 30 days</span></div>
                    <p class="activity-total"><strong>{{ activity.total }}</strong> unique machines</p>
                    <p class="activity-caption">Machines that downloaded recipes for currently listed versions, including dependencies. Each machine counts once across versions and repeat downloads. Requests without a machine ID are excluded.</p>
                    {% if activity.chart_ready %}
                    <div class="activity-chart" hidden data-activity-chart data-activity="{{ activity_json }}"><canvas role="img" aria-label="Daily unique machines downloading recipes over the last 30 days; exact values are in the table below."></canvas></div>
                    <details class="activity-data"><summary>Daily unique recipe downloads</summary>
                        <div class="package-table-scroll"><table class="pure-table"><caption>UTC days. A machine can appear on multiple days, so daily counts may sum to more than the period total. The first and last days may be partial.</caption><thead><tr><th scope="col">Date</th><th scope="col">Unique machines</th></tr></thead><tbody>
                        {% for day in activity.days %}<tr><td>{{ day.date }}{% if day.partial %} (partial){% endif %}</td><td>{% if day.available %}{{ day.count }}{% else %}History unavailable{% endif %}</td></tr>{% endfor %}
                        </tbody></table></div>
                    </details>
                    {% else %}<p class="activity-quiet">A daily chart appears after downloads from at least 10 unique machines across three active days.</p>{% endif %}
                    <p class="tracker-freshness{% if activity.stale %} is-delayed{% endif %}">{% if activity.stale %}Refresh delayed. {% endif %}{{ activity.window_start }} – {{ activity.updated }}.</p>
                <a class="tracker-version-link" href="/packages/tracker">See top packages →</a>
            </section>
            {% endif %}
            {% if download_platforms %}
            <section class="package-surface"><div class="package-section-heading"><h2>Recipe downloads by platform</h2><span class="period-badge">All time</span></div><p class="activity-caption">Recorded recipe requests across all versions, including dependencies, repeat downloads, and requests without a machine ID. These are not completed installations.</p>
                <div class="package-table-scroll"><table class="pure-table"><thead><tr><th scope="col">OS / architecture</th><th scope="col">Downloads</th></tr></thead><tbody>
                {% for row in download_platforms %}<tr><td>{{ row[0] }}</td><td>{{ row[1] }}</td></tr>{% endfor %}
                </tbody></table></div>
            </section>
            {% endif %}
            {% if stat_platforms %}
            <section class="package-surface"><div class="package-section-heading"><h2>Installation reports by platform</h2><span class="period-badge">All time</span></div><p class="activity-caption">Reported installations across all versions, including withdrawn versions.</p>
                <div class="package-table-scroll"><table class="pure-table"><thead><tr><th scope="col">Platform</th><th scope="col">Total</th><th scope="col">Success</th><th scope="col">Failure</th></tr></thead><tbody>
                {% for stat_platform in stat_platforms %}<tr><td>{{ stat_platform[0] }}</td><td>{{ stat_platform[1] }}</td><td>{{ stat_platform[2] }}</td><td>{{ stat_platform[3] }}</td></tr>{% endfor %}
                </tbody></table></div>
            </section>
            {% endif %}
        </div>
        <aside class="package-sidebar">
            <section class="package-surface"><h2>Package details</h2><dl class="package-details">
                {% if project_url %}<dt>Project</dt><dd><a href="{{ project_url }}">{{ project_url }}</a></dd>{% endif %}
                {% if license %}<dt>License</dt><dd>{{ license }}</dd>{% endif %}
                {% if publication_date %}<dt>First registry inclusion</dt><dd>{{ publication_date }}</dd>{% endif %}
                <dt>Available versions</dt><dd>{{ versions|length }}</dd>
            </dl></section>
            <section class="package-surface"><h2>Versions</h2><ul class="package-versions">
                {% for row in version_rows %}<li><a href="/package/{{ package_name|urlencode }}/{{ row.version|urlencode }}">{{ row.version }}</a>{% if row.version == latest_version %}<span class="latest-label">Latest</span>{% endif %}<span class="version-date">{{ row.date }}</span></li>{% endfor %}
            </ul></section>
        </aside>
    </div>
</main>
{% endblock %}
{% block scripts %}
    {% if activity.chart_ready %}<script src="{{ asset_urls['/js/chart.umd.js'] }}"></script>{% endif %}
    <script type="module" src="{{ asset_urls['/js/site.js'] }}"></script>
{% endblock %}
