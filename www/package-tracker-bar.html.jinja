<section class="tracker-bar" aria-label="Package Tracker highlights" data-tracker-bar>
    <div class="tracker-bar-heading"><a href="/packages/tracker">Package Tracker <span aria-hidden="true">↗</span></a>
        <div class="tracker-bar-controls" inert>
            <button type="button" data-tracker-rotation>Pause</button>
            <div class="tracker-selectors" role="group" aria-label="Choose a measure">
                {% for section in tracker.sections if section.rows %}<button type="button" data-tracker-select="{{ section.id }}" aria-pressed="false">{{ section.title }}</button>{% endfor %}
            </div>
        </div>
    </div>
    <div class="tracker-panels">
        {% for section in tracker.sections if section.rows %}
        <div class="tracker-panel" data-tracker-panel="{{ section.id }}"{% if not loop.first %} aria-hidden="true" inert{% endif %}>
            <p class="tracker-panel-label">{{ section.title }} <span>{{ section.period }}</span></p>
            <div class="tracker-highlights">
                {% for package in section.rows %}{% if loop.index <= 3 %}
                <div class="tracker-item"><a href="/package/{{ package.name|urlencode }}">{{ package.name }}</a><span>{{ package.metric }}</span></div>
                {% endif %}{% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>
    <div class="tracker-bar-footer"><span>{% if tracker.available %}{% if tracker.stale %}Refresh delayed · {% endif %}Updated {{ tracker.updated }}{% else %}Rankings refresh every 5 minutes{% endif %}</span><a href="/packages/tracker">See top packages →</a></div>
    <span class="visually-hidden" role="status" data-tracker-status></span>
</section>
