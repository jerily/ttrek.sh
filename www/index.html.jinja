
{% extends 'master.html.jinja' %}
{% block body_class %}home-page{% endblock %}
{% block content %}
{% include 'bashline.html.jinja' %}
    <main class="splash-container">
        <div class="splash">
            <p class="eyebrow">SMALL LANGUAGE. BIG POSSIBILITIES.</p>
            <h1 class="splash-head">{{ title }}</h1>
            <p class="splash-subhead">Your next Tcl project starts here.<br />Discover packages. Install dependencies. Keep building.</p>
            {% include 'search-form.html.jinja' %}
            <p class="search-examples">Try <a href="/search?q=web">web</a>, <a href="/search?q=json">json</a> or <a href="/search?q=compression">compression</a><span> · </span><a href="/packages">Browse all packages →</a></p>
            <div class="install-panel">
                <p>One command to get started</p>
                {{ bashline(install_command, "justify-content: center;") }}
            </div>
        </div>
    </main>
{% endblock %}
