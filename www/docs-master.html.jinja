{% extends 'master.html.jinja' %}
{% block home_selected %}{% endblock %}
{% block docs_selected %} pure-menu-selected{% endblock %}
{% block styles %}
{% if editing %}<link rel="stylesheet" href="{{ assets }}/editor.css" />{% endif %}
<link rel="stylesheet" href="{{ assets }}/style.css" />
<link rel="stylesheet" href="/css/docs.css" />
{% endblock %}
{% block content %}
<main class="documentation">
    <nav class="docs-navigation" aria-label="Documentation">
        {% for link in navigation %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}
    </nav>
    {% block body %}{% endblock %}
</main>
{% endblock %}
{% block scripts %}{% if editing %}<script defer src="{{ assets }}/markdown-editor.bundle.js"></script>{% endif %}{% endblock %}
