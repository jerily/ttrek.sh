package require tcltest 2
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root tcl telemetry.tcl]
set directory [makeDirectory telemetry-startup]
set settings [dict create dialect sqlite database [file join $directory telemetry.sqlite3]]

test telemetry-connect {connecting leaves schema creation to the explicit initdb procedure} -body {
    ::telemetry::connect $settings
    set before [::tpersist::_raw $::telemetry::connection {SELECT name FROM sqlite_master WHERE type = 'table'}]
    ::telemetry::initdb
    ::telemetry::initdb
    list $before [::telemetry::stats missing]
} -cleanup {::telemetry::close} -result {{} {}}

test telemetry-prepared {runtime startup and requests never call initdb or registry sync} -body {
    rename ::telemetry::initdb ::telemetry::real_initdb
    rename ::telemetry::sync_registry_metadata ::telemetry::real_sync_registry_metadata
    # Provide the initdb test fixture.
    proc ::telemetry::initdb {} {error "Runtime schema work forbidden"}
    # Provide the sync registry metadata test fixture.
    proc ::telemetry::sync_registry_metadata {args} {error "Runtime registry sync forbidden"}
    try {
        ::telemetry::connect $settings
        list [expr {$::telemetry::connection ne {}}] [::telemetry::stats missing]
    } finally {
        rename ::telemetry::initdb {}; rename ::telemetry::real_initdb ::telemetry::initdb
        rename ::telemetry::sync_registry_metadata {}; rename ::telemetry::real_sync_registry_metadata ::telemetry::sync_registry_metadata
        ::telemetry::close
    }
} -result {1 {}}

test telemetry-first-request {debug leaves SQL closed; the first SQL route connects without provisioning} -setup {
    set savedEnv [array get ::env ENV]
    set ::env(ENV) LOCAL
    source [file join $root tcl config.tcl]
    source [file join $root tcl site.tcl]
    source [file join $root tcl lambda.tcl]
    ::site::prepare_worker [dict create rootdir $root content_database {dialect sqlite database :memory:}]
    set ::site_lambda::router $::site::router
} -body {
    set before $::telemetry::connection
    set payload {{"httpMethod":"GET","path":"/debug","headers":{}}}
    set first [::site_lambda::handle $payload {}]
    set afterDebug $::telemetry::connection
    # The table is deliberately absent: this still exercises connection setup
    # and the handler's unavailable response without running runtime migrations.
    ::site_lambda::handle {{"httpMethod":"GET","path":"/registry/missing","headers":{}}} {}
    set connection $::telemetry::connection
    ::site_lambda::handle $payload {}
    list $before $afterDebug [dict get [::tjson::json_to_simple $first] statusCode] \
        [expr {$connection eq $::telemetry::connection}] \
        [::tpersist::_raw $connection {SELECT name FROM sqlite_master WHERE type = 'table'}]
} -cleanup {
    ::telemetry::close
    if {[info exists ::site::router]} {$::site::router destroy}
    unset -nocomplain ::site::router ::site_lambda::router ::site::pending_secrets
    unset ::env(ENV)
    array set ::env $savedEnv
} -result {{} {} 200 1 {}}

removeDirectory telemetry-startup
set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
