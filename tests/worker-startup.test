package require tcltest 2
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]

# Each case gets a fresh worker so package presence measures actual loading.
proc worker {{mode lazy} {environment LOCAL}} {
    set worker [interp create]
    $worker eval [list set auto_path $::auto_path]
    foreach package {jinja2 web-user web-forum web-static-wiki web-static-blog treqmon web-core web-user::manifest web-user::config web-forum::manifest web-static-wiki::manifest web-static-blog::manifest treqmon::routes} {
        foreach version [package versions $package] {
            $worker eval [list package ifneeded $package $version [package ifneeded $package $version]]
        }
    }
    $worker eval [list set root $::root]
    $worker eval [list set loading $mode]
    $worker eval [list set ::env(ENV) $environment]
    $worker eval {
        source [file join $root tcl site.tcl]
        source [file join $root tcl config.tcl]
        source [file join $root tcl lambda.tcl]
        set settings [dict create rootdir $root loading $loading content_database {dialect postgresql} \
            account {display {prefix /user origin https://ttrek.sh google_enabled true email_login_enabled true} policy {db_dialect sqlite collect_names true}}]
        set ::site_lambda::router [::site::prepare_worker $settings -secret_config {postgres {password private-value}}]
        proc loaded {packages} {
            set result {}
            foreach package $packages {if {[package provide $package] ne {}} {lappend result $package}}
            return $result
        }
        proc request {path {method GET} {headers {}}} {
            ::site::dispatch $::site::router [dict create method $method path $path headers $headers]
        }
    }
    return $worker
}

proc fake_database {worker} {
    $worker eval {
        namespace eval ::telemetry {variable connection {}; variable connects 0; variable fail false; variable event_list {}}
        proc ::telemetry::connect {config args} {
            incr ::telemetry::connects
            if {$::telemetry::fail} {error {Connection unavailable}}
            set ::telemetry::connection connection-$::telemetry::connects
        }
        namespace eval ::tpersist {}
        proc ::tpersist::db_dialect {connection} {return postgresql}
    }
}

test worker-routes {all methods and conditional package routes exist before implementation loading} -setup {
    set w [worker]
} -body {
    $w eval {
        set statuses {}
        foreach {method path} {GET /user/login POST /user/login POST /user/logout GET /user/profile GET /user/google/callback POST /user/google/start GET /user/email-login GET /forum GET /forum/topic/abc POST /forum/topic/abc GET /docs/guide GET /blog/post GET /request-monitor DELETE /user/login} {
            lappend statuses [dict get [$::site::router match $method $path] statusCode]
        }
        list $statuses [loaded {web-user web-forum web-static-wiki web-static-blog treqmon jinja2 tpersist bcrypt topenapi ttrie ttrigrams pure-tcl-aws-s3}] \
            $::views::templates [dict exists [::site::config] content_connection] [string match *private-value* [::site::config]]
    }
} -cleanup {interp delete $w} -result {{200 200 200 200 200 200 200 200 200 200 200 200 200 405} {} {} 0 0}

test worker-plan-hooks {native router and route hooks share one lazily prepared account mount} -setup {
    set w [worker]
    fake_database $w
} -body {
    $w eval {
        # Return a recognizable multiword binding in place of account storage.
        proc ::accounts::prepare {settings args} {return {tenant example}}
        # Record enter order on the request and check the bound mount value.
        proc entered {mount name context request} {
            if {$mount ne {tenant example}} {error "wrong mount"}
            dict lappend request visited $name
            return $request
        }
        # Record leave order on the outgoing response.
        proc left {mount name context request response} {
            dict lappend response visits [list $mount $name]
            return $response
        }
        # Echo the request as seen by the selected handler.
        proc received {mount literal request context params} {
            dict create statusCode 200 body [list $mount $literal [dict get $request visited] $context $params]
        }
        ::web::core::register web-hooks [file join $root tests fixtures web-hooks]
        set router [::tpathexp::router]
        try {
            set plan [::web::core::route_plan [::web::core::manifest web-hooks] /sample {} {} {} [list ::site::defer account]]
            ::web::core::install $router $plan
            set before $::telemetry::connects
            set res [$router dispatch {method GET path /sample/42} {trace demo}]
            set missing [$router dispatch {method GET path /missing}]
            list $before $::telemetry::connects [dict get $res body] [dict get $res visits] \
                [dict get $missing statusCode] [dict get $missing visits]
        } finally {$router destroy}
    }
} -cleanup {interp delete $w} -result {0 1 {{tenant example} @mount {global route} {trace demo} {id 42}} {{{tenant example} route} {{tenant example} global}} 404 {{{tenant example} global}}}

test worker-debug-prod {production returns 404 for GET and HEAD /debug} -setup {
    set w [worker lazy PROD]
} -body {
    $w eval {
        list [dict get [request /debug] statusCode] [dict get [request /debug HEAD] statusCode]
    }
} -cleanup {interp delete $w} -result {404 404}

test worker-debug {simple requests and unrelated cookies do not load account or rendering services} -setup {
    set w [worker]
} -body {
    $w eval {
        set first [request /debug]
        set second [request /debug GET {Cookie theme=dark}]
        list [dict get $first statusCode] [dict get $second statusCode] $::site::services \
            [loaded {web-user web-forum web-static-wiki web-static-blog jinja2 tpersist}] $::views::templates
    }
} -cleanup {interp delete $w} -result {200 200 {} {} {}}

test worker-lambda {Lambda dispatch uses the initialized router and does not initialize SQL for debug} -setup {
    set w [worker]
} -body {
    $w eval {
        set payload {{"httpMethod":"GET","path":"/debug","headers":{}}}
        set first [::site_lambda::handle $payload {}]
        set second [::site_lambda::handle $payload {}]
        list [dict get [::tjson::json_to_simple $first] statusCode] [expr {$first eq $second}] \
            [dict exists [::site::config] content_connection]
    }
} -cleanup {interp delete $w} -result {200 1 0}

test worker-invalid-event {invalid Lambda envelopes do not initialize any service} -setup {
    set w [worker]
} -body {
    $w eval {list [catch {::site_lambda::handle {{"unexpected":true}} {}}] $::site::services}
} -cleanup {interp delete $w} -result {1 {}}

test worker-database {the first SQL consumer connects; a warm worker reuses the connection} -setup {
    set w [worker]; fake_database $w
} -body {
    $w eval {
        request /debug
        set before $::telemetry::connects
        list $before [::site::database] [::site::database] $::telemetry::connects
    }
} -cleanup {interp delete $w} -result {0 connection-1 connection-1 1}

test worker-connect-retry {a failed connection leaves initialization retryable} -setup {
    set w [worker]; fake_database $w
} -body {
    $w eval {
        set ::telemetry::fail true
        set failed [catch {::site::database}]
        set partial [dict exists [::site::config] content_connection]
        set ::telemetry::fail false
        list $failed $partial [::site::database] $::telemetry::connects
    }
} -cleanup {interp delete $w} -result {1 0 connection-2 2}

test worker-service-retry {a failed feature can retry without rebuilding routes or reconnecting SQL} -setup {
    set w [worker]; fake_database $w
} -body {
    $w eval {
        set prepares 0
        proc ::accounts::prepare {settings args} {
            if {[incr ::prepares] == 1} {error {Prepare failed}}
            return {ready true}
        }
        set before [$::site::router match GET /user/login]
        set failed [catch {::site::service account}]
        set partial $::site::services
        list $failed $partial [::site::service account] [::site::service account] \
            $prepares $::telemetry::connects [expr {$before eq [$::site::router match GET /user/login]}]
    }
} -cleanup {interp delete $w} -result {1 {} {ready true} {ready true} 2 1 1}

test worker-anonymous-security {anonymous monitor requests fail closed and forged session fields are removed} -setup {
    set w [worker]
} -body {
    $w eval {
        set request [::accounts::monitor_enter {} {method GET path /debug headers {Cookie theme=dark} session {loggedin true id forged}}]
        list [dict exists $request session] [dict get [request /request-monitor] statusCode] \
            [loaded {web-user tpersist}] $::site::services
    }
} -cleanup {interp delete $w} -result {0 403 {} {}}

test worker-templates {an HTML response loads only reached templates and no account implementation} -setup {
    set w [worker]
} -body {
    $w eval {
        # Invalid search input still renders the search page, without querying SQL.
        set response [request /search]
        set first [[::views::environment site] loaded]
        request /search
        list [dict get $response statusCode] [expr {$first eq [[::views::environment site] loaded]}] \
            [expr {"packages.html.jinja" in $first && "master.html.jinja" in $first}] \
            [expr {"account-master.html.jinja" in $first || "forum-master.html.jinja" in $first || "package-tracker-bar.html.jinja" in $first}] \
            [loaded {web-user web-forum tpersist}] [dict exists [::site::config] content_connection]
    }
} -cleanup {interp delete $w} -result {400 1 1 0 {} 0}

# LOCAL eager startup preloads the SQLite session backend, omitted in production.
testConstraint sqliteSession [expr {![catch {package require tsession-sqlite 1.0.1}]}]

test worker-eager {eager prewarms code and templates, while SQL still waits for a consumer} -constraints sqliteSession -setup {
    set w [worker eager]
} -body {
    $w eval {
        list [loaded {web-user web-forum web-static-wiki web-static-blog treqmon jinja2}] \
            [expr {[llength [[::views::environment site] loaded]] > 5}] \
            [dict exists [::site::config] content_connection] $::site::services
    }
} -cleanup {interp delete $w} -result {{web-user web-forum web-static-wiki web-static-blog treqmon jinja2} 1 0 {}}

test worker-mode-parity {both modes retain identical route matching, rendered responses and HEAD behavior} -constraints sqliteSession -setup {
    set lazy [worker]; set eager [worker eager]
} -body {
    set checks {}
    foreach command {
        {$::site::router match POST /user/google/start}
        {$::site::router match DELETE /docs/guide}
        {request /debug}
        {request /search}
        {request /search HEAD}
        {request /request-monitor}
    } {
        lappend checks [expr {[$lazy eval $command] eq [$eager eval $command]}]
    }
    lsort -unique $checks
} -cleanup {interp delete $lazy; interp delete $eager} -result 1

testConstraint sqlite [expr {![catch {package require tpersist-sqlite}]}]
test worker-first-docs {a real docs request initializes only wiki and caches its templates and SQL connection} -constraints sqlite -setup {
    package require web-static-wiki
    set fixture [makeDirectory lazy-docs]
    set database [file join $fixture content.sqlite3]
    set source [file join $fixture content]
    file mkdir $source
    set channel [open [file join $source guide.md] w]
    puts $channel {# Lazy documentation}
    close $channel
    set connection [::tpersist::db_connect -dialect sqlite -database $database -autobegin false]
    try {
        ::web::static::wiki::initdb $connection
        ::web::static::wiki::sync [::web::static::wiki::create -connection $connection -domain ttrek.sh] $source
    } finally {::tpersist::db_disconnect $connection}
    set w [worker]
    $w eval [list dict set ::site::settings content_database [dict create dialect sqlite database $database]]
    $w eval {dict set ::site::private postgres {}}
} -body {
    $w eval {
        set before [$::site::router match GET /docs/guide]
        set response [request /docs/guide]
        set connection $::telemetry::connection
        set names [[::views::environment wiki] loaded]
        set head [request /docs/guide HEAD]
        list [dict get $response statusCode] [string match {*Lazy documentation*} [dict get $response body]] \
            [dict keys $::site::services] [loaded {web-user web-forum web-static-blog bcrypt tmfa tqrcodegen}] \
            [expr {$connection eq $::telemetry::connection && $names eq [[::views::environment wiki] loaded]}] \
            [expr {$before eq [$::site::router match GET /docs/guide]}] [dict get $head body] \
            [dict size $::web::static::wiki::templates]
    }
} -cleanup {
    catch {$w eval {::telemetry::close}}
    interp delete $w
    removeDirectory $fixture
} -result {200 1 wiki {} 1 1 {} 0}

test worker-config {loading comes from the environment, defaults to lazy and rejects invalid values} -setup {
    set saved_env [array get ::env]
    set w [worker]
} -body {
    $w eval {
        unset -nocomplain ::env(TTREK_LOADING)
        set result [list [::app_config::loading]]
        foreach mode {lazy eager {} typo} {
            set ::env(TTREK_LOADING) $mode
            catch {::app_config::loading} value
            lappend result $value
        }
        lappend result [catch {::site::configure [dict replace $settings loading typo]}]
    }
} -cleanup {
    interp delete $w
    array unset ::env
    array set ::env $saved_env
} -result {lazy lazy eager {TTREK_LOADING must be lazy or eager} {TTREK_LOADING must be lazy or eager} 1}

set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
