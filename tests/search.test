source [file join $root tcl search-build.tcl]
set search_fixture [::tcltest::makeDirectory search-registry]
set search_artifacts [::tcltest::makeDirectory search-artifacts]
set search_snapshot [file join $search_artifacts search.json]
proc search_recipe {root name version {description {}}} {
    set directory [file join $root $name $version]
    file mkdir $directory
    set channel [open [file join $directory ttrek.json] w]
    puts $channel [::tjson::typed_to_json [list M [dict create description [list S $description]]]]
    close $channel
}
foreach name {tcl tclx tk tcl-tk a-c a_c a.c a+c abc web webserver atweb zzwebzzz b wec encryption} {
    foreach version {1.0.0 2.0.0} {search_recipe $search_fixture $name $version}
}
foreach {name description} {
    twebserver {A Tcl web server.}
    portal {Embedded Web platform.}
    doc-server {Fast web server.}
    doc-encryption {Encryption toolkit.}
    literal-typo {Literal encrytion phrase.}
} {search_recipe $search_fixture $name 1.0.0 $description}
search_recipe $search_fixture twebserver 2.0.0 {Compression utilities.}
file mkdir [file join $search_fixture tclz 1.0.0]
rename ::recipe_search::index ::recipe_search::original_index
rename ::recipe_search::descriptions ::recipe_search::original_descriptions
set saved_entries $::recipe_search::entries
set saved_documents $::recipe_search::documents
::recipe_search::build $search_fixture $search_snapshot
::recipe_search::load $search_snapshot
proc search_names {query} {
    lmap match [::recipe_search::search $query] {dict get $match name}
}

test search-1 {Exact, prefix and substring names precede descriptions and typo suggestions} -body {
    search_names web
} -result {web webserver atweb zzwebzzz twebserver doc-server portal wec}

test search-2 {Case folding, whitespace and short-query typo limit} -body {
    list [expr {[search_names { WEB }] eq [search_names web]}] [search_names TCL] \
        [expr {"b" ni [search_names web]}] [lindex [search_names b] 0]
} -result {1 {tcl tclx tcl-tk twebserver} 1 b}

test search-3 {Punctuation is preserved; names occur once across versions} -body {
    search_names a_c
} -result {a_c a+c a-c a.c abc}

test search-4 {Description literals precede name typos and description typo suggestions} -body {
    lrange [search_names encrytion] 0 2
} -result {literal-typo encryption doc-encryption}

test search-5 {Index every version and display the matching description} -body {
    set response [get_search_handler {} {queryStringParameters {q compression}}]
    set matches [::tjson::json_to_simple [dict get $response body]]
    list [dict get $response status] [dict get $response type] $matches
} -result {200 application/json {{name twebserver description {Compression utilities.} match description distance 0 coverage 1}}}

test search-6 {Phrase queries and description display for a name substring} -body {
    set response [get_search_handler {} {queryStringParameters {q web}}]
    set matches [::tjson::json_to_simple [dict get $response body]]
    set found [lindex $matches 4]
    list [lrange [search_names {web server}] 0 1] [dict get $found description] \
        [dict get $found match] [dict exists $found distance]
} -result {{doc-server twebserver} {A Tcl web server.} substring 0}

test search-7 {Invalid queries return 400 and no matches is an empty JSON array} -body {
    set statuses [list [dict get [get_search_handler {} {}] status]]
    foreach query [list {} {   } . .. ../etc café "abc\n" "a\u0000b" [string repeat a 256]] {
        lappend statuses [dict get [get_search_handler {} [dict create queryStringParameters [dict create q $query]]] status]
    }
    list [lsort -unique $statuses] [dict get [get_search_handler {} {queryStringParameters {q unknown}}] body]
} -result {400 {[]}}

test search-8 {Bad descriptions preserve the artifact and working indexes} -body {
    set channel [open $search_snapshot rb]
    set before [read $channel]
    close $channel
    set invalid [file join $search_fixture bad 1.0.0]
    file mkdir $invalid
    set rejected {}
    foreach json {{"description":42} {"description":null} {"description":{}} {"description":"bad\nline"}} {
        set channel [open [file join $invalid ttrek.json] w]
        puts $channel \{$json\}
        close $channel
        lappend rejected [catch {::recipe_search::build $search_fixture $search_snapshot} message]
        if {![string match {*description must be*} $message]} {error $message}
    }
    file delete -force [file join $search_fixture bad]
    set channel [open $search_snapshot rb]
    set after [read $channel]
    close $channel
    list [lsort -unique $rejected] [expr {$before eq $after}] [lindex [search_names web] 0]
} -result {1 1 web}

test search-snapshot-1 {Builds are deterministic and do not change the active index} -body {
    set channel [open $search_snapshot rb]
    set before [read $channel]
    close $channel
    ::recipe_search::build $search_fixture $search_snapshot
    set channel [open $search_snapshot rb]
    set after [read $channel]
    close $channel
    list [expr {$before eq $after}] [search_names compression]
} -result {1 twebserver}

test search-snapshot-2 {Invalid loads preserve both active indexes and clean up temporary commands} -body {
    set channel [open $search_snapshot r]
    set json [read $channel]
    close $channel
    ::tjson::parse $json snapshot
    set fields [lindex [::tjson::to_typed $snapshot] 1]
    set rejected {}
    foreach {field invalid} {format {N 2} entries {L {}} documents {L {{L {{S missing} {S text}}}}} \
            documents {L {}} names {S invalid!} descriptions {S invalid!}} {
        set broken [dict replace $fields $field $invalid]
        set channel [open [file join $search_artifacts broken.json] w]
        puts $channel [::tjson::typed_to_json [list M $broken]]
        close $channel
        lappend rejected [catch {::recipe_search::load [file join $search_artifacts broken.json]}]
    }
    list [lsort -unique $rejected] [lindex [search_names web] 0] [search_names compression] \
        [info commands ::recipe_search::next_*]
} -result {1 web twebserver {}}

test search-9 {Fresh workers load without registry files or index construction} -body {
    set expected [lmap query {web TCL a_c encrytion compression {web server} unknown} {
        ::recipe_search::search $query
    }]
    file delete -force $search_fixture
    interp create worker
    try {
        worker eval [list set auto_path $auto_path]
        worker eval [list source [file join $root tcl search.tcl]]
        worker eval {
            foreach name {ttrie ttrigrams} {
                rename ::${name}::create {}
                proc ::${name}::create {args} {error "Index construction is forbidden at runtime"}
            }
        }
        worker eval [list ::recipe_search::load $search_snapshot]
        set actual [worker eval {
            lmap query {web TCL a_c encrytion compression {web server} unknown} {::recipe_search::search $query}
        }]
    } finally {interp delete worker}
    expr {$expected eq $actual}
} -result 1

test search-10 {Missing registry fails the build} -body {
    ::recipe_search::build $search_fixture $search_snapshot
} -returnCodes error -result {Search registry directory does not exist}

test search-snapshot-3 {Missing snapshot fails loading without rebuilding} -body {
    ::recipe_search::load [file join $search_artifacts missing.json]
} -returnCodes error -result {Search snapshot is missing; run the build-search script}

::tcltest::removeDirectory search-artifacts
::recipe_search::index destroy
::recipe_search::descriptions destroy
rename ::recipe_search::original_index ::recipe_search::index
rename ::recipe_search::original_descriptions ::recipe_search::descriptions
set ::recipe_search::entries $saved_entries
set ::recipe_search::documents $saved_documents
