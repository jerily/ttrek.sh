package require tcltest 2
namespace import ::tcltest::test
source [file join [file dirname [info script]] .. tcl config.tcl]

set root [::tcltest::makeDirectory config-fixture]
file mkdir [file join $root etc]
foreach name {config.ini config.enc config.local.ini} {
    close [open [file join $root etc $name] w]
}
set saved_env [array get ::env ENV]
namespace eval ::tconfig {
    proc read_config {path} {dict create redis {host production.example port 6379 password test} loaded [file tail $path]}
    proc load_config {path} {read_config $path}
}

test config-1 {Default production mode prefers encrypted configuration} -body {
    unset -nocomplain ::env(ENV)
    set config [::app_config::load $root]
    list [dict get $config loaded] [dict get $config redis host]
} -result {config.enc production.example}

test config-2 {Local mode selects only local configuration and forces localhost} -body {
    set ::env(ENV) LOCAL
    set config [::app_config::load $root]
    list [dict get $config loaded] [dict get $config redis host]
} -result {config.local.ini localhost}

test config-3 {Invalid mode fails} -body {
    set ::env(ENV) invalid
    ::app_config::load $root
} -returnCodes error -result {ENV must be LOCAL or PROD}

test config-4 {Local mode cannot fall back to production} -body {
    set ::env(ENV) LOCAL
    file delete [file join $root etc config.local.ini]
    ::app_config::load $root
} -returnCodes error -result {ENV=LOCAL requires etc/config.local.ini}

test config-5 {Production TLS cannot be disabled through configuration} -body {
    set ::env(ENV) PROD
    set settings [::app_config::valkey {redis {host localhost port 6379 password test ssl false}}]
    list [dict get $settings ssl] [dict get $settings username]
} -result {true appuser}

test config-6 {Missing credentials fail before connecting} -body {
    set ::env(ENV) PROD
    ::app_config::valkey {redis {host localhost port 6379}}
} -returnCodes error -match glob -result {Set redis.password*}

test config-7 {Local plain TCP supports the existing unauthenticated loopback service} -body {
    set ::env(ENV) LOCAL
    set settings [::app_config::valkey {redis {host remote.example port 6379 password {} ssl false ssl_ca_file local/cert.pem}}]
    list [dict get $settings host] [dict get $settings port] [dict get $settings ssl] \
        [dict exists $settings password] [dict exists $settings username] [dict exists $settings ssl_ca_file]
} -result {localhost 6379 false 0 0 0}

test config-8 {Relative certificate paths resolve against the project root} -setup {
    close [open [file join $root etc config.local.ini] w]
    rename ::tconfig::read_config ::tconfig::saved_read_config
    proc ::tconfig::read_config {path} {dict create redis {host localhost ssl_ca_file local/cert.pem}}
} -body {
    set ::env(ENV) LOCAL
    set config [::app_config::load $root]
    expr {[dict get $config redis ssl_ca_file] eq [file normalize [file join $root local/cert.pem]]}
} -cleanup {
    rename ::tconfig::read_config {}
    rename ::tconfig::saved_read_config ::tconfig::read_config
} -result 1

test config-9 {Local authenticated TLS remains supported} -body {
    set ::env(ENV) LOCAL
    set settings [::app_config::valkey {redis {host remote.example port 6379 password test ssl true ssl_ca_file local/cert.pem}}]
    list [dict get $settings host] [dict get $settings ssl] [dict get $settings username] [dict get $settings password]
} -result {localhost true appuser test}

test config-10 {Registry defaults to the application submodule in both modes} -body {
    set result {}
    foreach mode {LOCAL PROD} {
        set ::env(ENV) $mode
        set config [::app_config::load $root]
        lappend result [expr {[dict get $config registry directory] eq [file join $root registry]}]
    }
    set result
} -result {1 1}

test config-11 {Relative registry directories resolve against the application root, not the working directory} -setup {
    rename ::tconfig::read_config ::tconfig::saved_read_config
    proc ::tconfig::read_config {path} {dict create registry {directory {packages [local]}}}
    set saved_cwd [pwd]
    cd [file join $root etc]
} -body {
    set ::env(ENV) LOCAL
    set config [::app_config::load $root]
    expr {[dict get $config registry directory] eq [file join $root {packages [local]}]}
} -cleanup {
    cd $saved_cwd
    rename ::tconfig::read_config {}
    rename ::tconfig::saved_read_config ::tconfig::read_config
} -result 1

test config-12 {Absolute registry paths in production configuration remain absolute} -setup {
    rename ::tconfig::read_config ::tconfig::saved_read_config
    proc ::tconfig::read_config {path} {dict create registry [dict create directory $::root]}
} -body {
    set ::env(ENV) PROD
    dict get [::app_config::load $root] registry directory
} -cleanup {
    rename ::tconfig::read_config {}
    rename ::tconfig::saved_read_config ::tconfig::read_config
} -result $root

test config-13 {An empty registry directory cannot expose the application root} -setup {
    rename ::tconfig::read_config ::tconfig::saved_read_config
    proc ::tconfig::read_config {path} {dict create registry {directory {}}}
} -body {
    set ::env(ENV) LOCAL
    ::app_config::load $root
} -cleanup {
    rename ::tconfig::read_config {}
    rename ::tconfig::saved_read_config ::tconfig::read_config
} -returnCodes error -result {registry.directory must not be empty}

test releases-config-1 {Downloads default to disabled with a short URL lifetime} -body {
    set settings [::app_config::releases {}]
    list [dict get $settings bucket] [dict get $settings url_expiry_seconds]
} -result {{} 300}

test releases-config-2 {Release settings normalize prefixes} -body {
    set settings [::app_config::releases {releases {bucket public-releases region eu-west-1 prefix /ttrek/1.0.0/}}]
    list [dict get $settings prefix] [dict get $settings region]
} -result {ttrek/1.0.0 eu-west-1}

test releases-config-3 {Invalid release settings fail before serving requests} -body {
    set result {}
    foreach settings {
        {bucket https://bucket.example region us-east-1}
        {bucket public-releases region {}}
        {url_expiry_seconds 0} {url_expiry_seconds 604801} {url_expiry_seconds invalid}
        {prefix ../secret} {version latest} {checksums {linux-amd64-glibc invalid}}
    } {
        lappend result [catch {::app_config::releases [dict create releases $settings]}]
    }
    set result
} -result {1 1 1 1 1 1 1 1}

test releases-config-4 {Mock S3 endpoint is restricted to loopback in LOCAL mode} -body {
    set result {}
    foreach {mode endpoint} {
        LOCAL http://127.0.0.1:3015
        LOCAL http://localhost:3015
        PROD http://127.0.0.1:3015
        LOCAL http://example.com:3015
        LOCAL http://127.0.0.1:3015/path
    } {
        set ::env(ENV) $mode
        lappend result [catch {::app_config::releases [dict create releases [dict create endpoint $endpoint]]}]
    }
    set result
} -result {0 0 1 1 1}

set checksums_fixture [file join [file dirname [info script]] fixtures release-checksums.json]
test releases-config-5 {Checksums are selected by environment and version without falling back} -body {
    set result {}
    foreach {mode version} {LOCAL 1.0.0 PROD 1.0.0 PROD 1.1.0 PROD 9.0.0 LOCAL 1.1.0} {
        set ::env(ENV) $mode
        set settings [::app_config::releases [dict create releases [dict create checksums_file $checksums_fixture version $version]]]
        lappend result [dict get $settings checksums]
    }
    set result
} -result [list [dict create linux-amd64-glibc [string repeat b 64]] \
    [dict create linux-amd64-glibc [string repeat a 64]] \
    [dict create macos-arm64 [string repeat c 64]] {} {}]

test releases-config-6 {Missing and malformed checksum manifests fail startup} -body {
    set result [list [catch {::app_config::release_checksums [file join $root absent.json] 1.0.0}]]
    foreach text [list "\{" {[]} {{"prod":[]}} {{"prod":{"latest":{}}}} \
        {{"prod":{"1.0.0":{"linux-amd64-glibc":"bad"}}}} \
        {{"prod":{"1.0.0":{"linux-amd64-glibc":123}}}} \
        {{"other":{}}}] {
        set path [file join $root invalid.json]
        set channel [open $path w]
        puts $channel $text
        close $channel
        lappend result [catch {::app_config::release_checksums $path 1.0.0}]
    }
    set result
} -result {1 1 1 1 1 1 1 1}

test releases-config-7 {Checksum paths resolve from the application root in both config modes} -setup {
    file copy -force $checksums_fixture [file join $root etc releases.json]
    rename ::tconfig::read_config ::tconfig::saved_read_config
    proc ::tconfig::read_config {path} {dict create redis {host localhost} releases {checksums_file etc/releases.json}}
    set saved_cwd [pwd]
    cd /tmp
} -body {
    set result {}
    foreach mode {LOCAL PROD} {
        set ::env(ENV) $mode
        set config [::app_config::load $root]
        lappend result [expr {[dict get $config releases checksums_file] eq [file join $root etc releases.json]}]
        lappend result [dict keys [dict get [::app_config::releases $config] checksums]]
    }
    set result
} -cleanup {
    cd $saved_cwd
    rename ::tconfig::read_config {}
    rename ::tconfig::saved_read_config ::tconfig::read_config
} -result {1 linux-amd64-glibc 1 linux-amd64-glibc}

test releases-config-8 {Local stack reads the same versioned manifest through the INI reference} -body {
    set ::env(ENV) LOCAL
    set path [file join $root etc release.ini]
    set channel [open $path w]
    puts $channel "\[releases\]\nversion=1.0.0\nchecksums_file=etc/releases.json"
    close $channel
    dict get [::app_config::releases_from_ini $path $root] checksums linux-amd64-glibc
} -result [string repeat b 64]

test releases-config-9 {Unrelated local configuration keeps default release settings} -body {
    set path [file join $root etc registry-only.ini]
    set channel [open $path w]
    puts $channel "\[registry\]\ndirectory=registry"
    close $channel
    dict get [::app_config::releases_from_ini $path $root] version
} -result 1.0.0

unset -nocomplain ::env(ENV)
array set ::env $saved_env
::tcltest::removeDirectory config-fixture
set failed $::tcltest::numTests(Failed)
::tcltest::cleanupTests
exit [expr {$failed > 0}]
