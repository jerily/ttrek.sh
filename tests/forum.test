package require tcltest
package require web-user 0.5.0
package require web-forum 0.3.0
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root tcl config.tcl]
source [file join $root tcl site.tcl]
source [file join $root tcl patch.tcl]
source [file join $root tcl lambda.tcl]
set ::env(ENV) LOCAL
set work [makeDirectory forum-site]
set db [::tpersist::db_connect -database :memory: -autobegin false]
foreach package {user forum} {::web::${package}::initdb $db}
foreach package {wiki blog} {::web::static::${package}::initdb $db}
set raw {groups {admin mira@example.com} forum {moderation true posting_captcha true page_size 2}}
set settings [dict create rootdir $root content_connection $db content_images {} \
    account [::app_config::account $raw $root $work] forum [::app_config::forum $raw]]
set separated [::private_config::partition $settings]
set settings [dict get $separated config]
set siteSecrets [dict get $separated secret_config]
::site::init_worker $settings -secret_config $siteSecrets
set store $::accounts::store
set uid user_[ksuid::generate_ksuid]
::web::user::insert $store web_user_users [dict create id $uid active 1 verified 1 email_key [::web::user::email_key $store mira@example.com] email [::web::user::seal $store mira@example.com [list email $uid]] password unused mfa_secret {} last_step -1 revision 0 created_at 1]
set token [::web::user::new_session $store auth $uid]
set cookie [lindex [split [dict get [::web::user::set_cookie $::accounts::mount {} $token] headers Set-Cookie] {;}] 0]
set signed [dict create method GET headers [dict create cookie $cookie]]
set ::site_lambda::router $::site::router

test site-forum-1 {forum uses the host layout and replaces the Home navigation link} -body {
    set response [::site::dispatch $::site::router {method GET path /forum}]
    set html [dict get $response body]
    list [dict get $response statusCode] [string match {*href="/forum" class="pure-menu-link">Forum</a>*} $html] \
        [string match {*pure-menu-link">Home</a>*} $html] [string match {*forum.css*} $html] \
        [dict get $response headers Cache-Control]
} -result {200 1 0 1 no-store}

test site-forum-2 {startup is read-only; explicit patch sync grants and revokes permissions} -body {
    set before [::web::user::permissions $store $uid]
    set event {{"source":"ttrek.patch","task":"task_sync_access"}}
    set result [::tjson::json_to_simple [::site_lambda::handle $event {}]]
    set granted [::web::user::permissions $store $uid]
    set queue [$::site::router dispatch [dict merge $signed {path /forum/moderation}]]
    dict set ::site::settings account access groups admin {}
    ::site_lambda::handle $event {}
    list $before [dict get $result ok] $granted [dict get $queue statusCode] \
        [::web::user::permissions $store $uid] \
        [dict get [$::site::router dispatch [dict merge $signed {path /forum/moderation}]] statusCode]
} -result {{} 1 {blog.edit forum.moderate request_monitor.view users.manage wiki.edit} 200 {} 403}

test site-forum-3 {forum settings reach forms and HTTP requests cannot invoke maintenance} -body {
    set response [$::site::router dispatch [dict merge $signed {path /forum/new}]]
    set html [dict get $response body]
    set event {{"source":"ttrek.patch","task":"task_sync_access","httpMethod":"POST","path":"/patch","headers":{},"body":""}}
    set result [::tjson::json_to_simple [::site_lambda::handle $event {}]]
    list [string match {*name="captcha_id"*} $html] [string match {*Submit for review*} $html] \
        [expr {[dict get $result statusCode] in {404 405}}]
} -result {1 1 1}

test site-users-admin {Account links to the protected user list through the shared host layout} -body {
    dict set ::site::settings account access groups admin mira@example.com
    ::site_lambda::handle {{"source":"ttrek.patch","task":"task_sync_access"}} {}
    set account [::site::dispatch $::site::router [dict merge $signed {path /user}]]
    set page [::site::dispatch $::site::router [dict merge $signed {path /user/admin/users}]]
    set html [dict get $page body]
    dict set ::site::settings account access groups admin {}
    ::site_lambda::handle {{"source":"ttrek.patch","task":"task_sync_access"}} {}
    list [string match {*href="/user/admin/users">Manage users*} [dict get $account body]] \
        [dict get $page statusCode] [dict get $page headers Cache-Control] \
        [string match {*mira@example.com*} $html] [string match {*Authenticator / MFA*} $html] \
        [string match {*pure-menu-link">Forum*} $html] \
        [dict get [::site::dispatch $::site::router [dict merge $signed {path /user/admin/users}]] statusCode]
} -result {1 200 no-store 1 1 1 403}

test site-package-cdn {Forum, editor and admin pages use stable CloudFront assets with an allowed CSP origin} -setup {
    set originalSettings $::site::settings
    set originalRouter $::site::router
    dict set ::site::settings account access groups admin mira@example.com
    ::accounts::sync_access
    set ::env(ENV) PROD
    set ::env(CONTENT_IMAGES_CLOUDFRONT_URL) https://cdn.example
    set cdnSettings $originalSettings
    dict set cdnSettings content_images [::app_config::content_images {content_images {cloudfront_enabled true}} $root]
    ::site::configure $cdnSettings
    # Keep the existing local account fixture while using production CDN URLs.
    set ::env(ENV) LOCAL
    set ::site::router [::tpathexp::router]
    ::site::mount $::site::router -secret_config $siteSecrets
} -body {
    set checks {}
    foreach {path assets} {
        /forum {/forum/_assets/forum.css}
        /forum/new {/forum/_assets/forum.css /forum/_assets/editor.css /forum/_assets/markdown-editor.bundle.js}
        /user/admin/users {/user/_assets/admin.css}
    } {
        set response [::site::dispatch $::site::router [dict merge $signed [dict create path $path]]]
        set html [dict get $response body]
        lappend checks [expr {[dict get $response statusCode] == 200}]
        foreach asset $assets {
            lappend checks [expr {[string first "https://cdn.example/cdn$asset" $html] >= 0}] \
                [expr {[string first "=\"$asset\"" $html] < 0}]
        }
        lappend checks [expr {[string first https://cdn.example [::responses::header $response Content-Security-Policy]] >= 0}]
    }
    lsort -unique $checks
} -cleanup {
    $::site::router destroy
    set ::env(ENV) LOCAL
    unset ::env(CONTENT_IMAGES_CLOUDFRONT_URL)
    ::site::configure $originalSettings
    set ::site::router $originalRouter
    # Restore the mount's registered key handles for subsequent requests.
    $originalRouter destroy
    ::site::init_worker $originalSettings -secret_config $siteSecrets
    set store $::accounts::store
    set ::site_lambda::router $::site::router
} -result 1

test site-users-id-migration {private patch migrates user identity and existing sessions idempotently} -body {
    set old [::ksuid::generate_ksuid]
    set hash [::web::user::password_hash {a migration password} {bcrypt_cost 4}]
    ::web::user::insert $store web_user_users [dict create id $old active 1 verified 1 \
        email_key [::web::user::email_key $store before@example.com] \
        email [::web::user::seal $store before@example.com [list email $old]] \
        password [::web::user::seal $store $hash [list password-hash $old]] \
        mfa_secret {} last_step -1 revision 0 created_at 1]
    set token [::web::user::new_session $store auth $old]
    set event {{"source":"ttrek.patch","task":"task_migrate_user_ids"}}
    set first [::tjson::json_to_simple [::site_lambda::handle $event {}]]
    set second [::tjson::json_to_simple [::site_lambda::handle $event {}]]
    set user [::web::user::user_by_id $store user_$old]
    set public [::site_lambda::handle {{"source":"ttrek.patch","task":"task_migrate_user_ids","httpMethod":"POST","path":"/patch","headers":{},"body":""}} {}]
    set public [::tjson::json_to_simple $public]
    list [dict get $first completed] [dict get $second completed] \
        [dict get [::web::user::public_user $store $user] email] \
        [expr {[dict get [::web::user::session $store $token] uid] eq "user_$old"}] \
        [expr {[dict get $public statusCode] in {404 405}}]
} -result {{users:1 registrations:0 profiles:0 sessions:1} {users:0 registrations:0 profiles:0 sessions:0} before@example.com 1 1}

$::site::router destroy
::web::user::release $::accounts::mount
::tpersist::db_disconnect $db
removeDirectory $work
cleanupTests
