package require tcltest
package require web-user
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root tcl config.tcl]
source [file join $root tcl site.tcl]
foreach package {web-static-wiki web-static-blog treqmon jinja2 tcaptcha} {package require $package}
source [file join $root tcl patch.tcl]
source [file join $root tcl lambda.tcl]
set ::env(ENV) LOCAL
set work [makeDirectory account-site]
set db [::tpersist::db_connect -database :memory: -autobegin false]
::web::user::initdb $db
package require web-forum
::web::forum::initdb $db
::web::static::wiki::initdb $db
::web::static::blog::initdb $db
foreach kind {wiki blog} directory {docs blog} {
    ::web::static::${kind}::sync [dict get [::content_images::database_stores $db {}] $kind] [file join $root content $directory]
}
set account [::app_config::account {} $root $work]
# The registration tests use the LOCAL verification code in the response.
# Exercise the actual delivery callback separately with a captured SES client.
dict set account display email_enabled false
dict set account policy bcrypt_cost 4
namespace eval ::treqmon::middleware::accountsteststore {
    variable history {}
    proc init {config} {variable history; set history {}; set ::treqmon::worker::memstore::recent_requests {}}
    proc register_datapoint {point} {variable history; lappend history $point}
    proc get_history_events {} {variable history; return $history}
    proc register_recent_request {request} {::treqmon::worker::memstore::register_recent_request $request}
    proc get_recent_requests {} {::treqmon::worker::memstore::get_recent_requests}
}
set settings [dict create rootdir $root content_connection $db content_images {} account $account \
    treqmon {store {accountsteststore {}}}]
set separated [::private_config::partition $settings]
set settings [dict get $separated config]
set siteSecrets [dict get $separated secret_config]
# Exercise real mounts with production's validation policy and a disposable
# SQLite store. The rest of this suite renders these prevalidated templates.
rename ::site::validate_templates ::site::real_validate_templates
proc ::site::validate_templates {} {return false}
rename ::jinja2::validate ::jinja2::real_validate
proc ::jinja2::validate {args} {error "Production mounts must not validate templates"}
try {
    ::site::init_worker $settings -secret_config $siteSecrets
} finally {
    rename ::site::validate_templates {}
    rename ::site::real_validate_templates ::site::validate_templates
    rename ::jinja2::validate {}
    rename ::jinja2::real_validate ::jinja2::validate
}
namespace eval ::accountstest {
    variable cookie {}; variable csrf {}; variable last {}; variable origin http://localhost:8080
    variable lambdaVersion {}; variable extraCookies {}
}

# Exercise the JSON transport boundary, including API Gateway's cookie array and nullable maps.
proc ::accountstest::lambda_request {request version} {
    set headers [dict get $request headers]
    set event [dict create path [list S [dict get $request path]] \
        httpMethod [list S [dict get $request method]]]
    if {$version eq "2.0"} {
        dict set event version {S 2.0}
        dict set event rawPath [list S [dict get $request path]]
        dict set event rawQueryString [list S [dict get $request queryString]]
        dict set event requestContext [list M [dict create http [list M [dict create \
            method [list S [dict get $request method]] sourceIp {S 127.0.0.1}]]]]
        set cookies {}
        foreach cookie [split [dict get $headers cookie] {;}] {
            if {[string trim $cookie] ne {}} {lappend cookies [list S [string trim $cookie]]}
        }
        dict set event cookies [list L $cookies]
        dict unset headers cookie
    } else {
        dict set event pathParameters {N null}
        dict set event multiValueHeaders {N null}
        dict set event multiValueQueryStringParameters {N null}
        dict set event queryStringParameters {N null}
        foreach pair [split [dict get $request queryString] &] {
            set at [string first = $pair]
            if {$at < 0} {continue}
            set key [::web::user::decode [string range $pair 0 [expr {$at - 1}]]]
            set value [::web::user::decode [string range $pair [expr {$at + 1}] end]]
            dict set query $key [list S $value]
        }
        if {[info exists query]} {dict set event queryStringParameters [list M $query]}
    }
    dict set event headers [list M [::web::user::text_fields $headers]]
    if {[dict exists $request body]} {
        dict set event body [list S [binary encode base64 -maxlen 0 [dict get $request body]]]
        dict set event isBase64Encoded {BOOL 1}
    }
    set ::site_lambda::router $::site::router
    set response [::tjson::json_to_simple [::site_lambda::handle \
        [encoding convertto utf-8 [::tjson::typed_to_json [list M $event]]] {}]]
    dict set response body [encoding convertfrom utf-8 [binary decode base64 [dict get $response body]]]
    dict set response isBase64Encoded false
    return $response
}
# Send a real site request while retaining the browser's account cookie and CSRF token.
proc ::accountstest::request {method path {fields {}}} {
    variable cookie
    variable csrf
    variable last
    variable origin
    variable lambdaVersion
    variable extraCookies
    set at [string first ? $path]
    set query {}
    if {$at >= 0} {
        set query [string range $path [expr {$at + 1}] end]
        set path [string range $path 0 [expr {$at - 1}]]
    }
    set request [dict create method $method path $path queryString $query \
        headers [dict create cookie [join [concat [list $cookie] $extraCookies] {; }] Host [lindex [split $origin /] 2]]]
    if {$method eq "POST"} {
        dict set fields csrf $csrf
        set pairs {}
        dict for {name value} $fields {lappend pairs [::web::user::uri_component $name]=[::web::user::uri_component $value]}
        dict set request body [join $pairs &]
        dict set request headers content-type application/x-www-form-urlencoded
        dict set request headers Origin $origin
    }
    if {$lambdaVersion eq {}} {
        set last [::site::dispatch $::site::router $request {addr 127.0.0.1}]
    } else {
        set last [lambda_request $request $lambdaVersion]
    }
    if {[dict exists $last headers Set-Cookie]} {set cookie [lindex [split [dict get $last headers Set-Cookie] {;}] 0]}
    regexp {name="csrf" value="([^"]+)"} [dict get $last body] -> csrf
    return [dict get $last statusCode]
}
rename ::tcaptcha::image ::tcaptcha::site_test_image
# Capture the generated answer only inside this test interpreter.
proc ::tcaptcha::image {text} {set ::accountstest::answer $text; site_test_image $text}

test accounts-anonymous-query-count {fresh email login creates both throttle buckets and sessions in four statements} -body {
    set ::account_queries 0
    proc count_account_queries {args} {incr ::account_queries}
    trace add execution ::tpersist::db_execute enter count_account_queries
    try {set status [::accountstest::request GET /user/email-login]} finally {
        trace remove execution ::tpersist::db_execute enter count_account_queries
        rename count_account_queries {}
    }
    list $status $::account_queries
} -cleanup {set ::accountstest::cookie {}; set ::accountstest::csrf {}} -result {200 4}

test accounts-config {site defaults enable CAPTCHA, six-character password minimum, and persistent development keys} -body {
    set again [::app_config::account {} $root $work]
    list [dict get $account policy registration_captcha] [dict get $account policy password_min_length] \
        [expr {[dict get $account secret_config] eq [dict get $again secret_config]}]
} -result {true 6 1}

test accounts-guests {Signed-out visitors see only sign-in in the account navigation} -body {
    set result {}
    foreach path {/ /docs /blog /user/register /user/login} {
        lappend result [::accountstest::request GET $path]
        set html [dict get $::accountstest::last body]
        lappend result [expr {![string match {*class="pure-menu-link">Sign up</a>*} $html]}] \
            [string match {*class="pure-menu-link">Sign in</a>*} $html] \
            [expr {![string match {*class="pure-menu-link">Account</a>*} $html]}]
    }
    lsort -unique $result
} -result {1 200}

test accounts-canonical {Account forms identify their clean URL with or without a return destination} -body {
    foreach path {/user/forgot /user/register /user/login /user/email-login} {
        foreach suffix {{} ?return_to=%2Fforum%3Fpage%3D2} {
            set status [::accountstest::request GET $path$suffix]
            set html [dict get $::accountstest::last body]
            set links [regexp -all -inline {<link rel="canonical" href="([^"]+)" />} $html]
            if {$status != 200 || [llength $links] != 2 || [lindex $links 1] ne "https://ttrek.sh$path" ||
                [string first [lindex $links 0] $html] > [string first </head> $html]} {
                error "Unexpected canonical for $path$suffix (HTTP $status): $links"
            }
        }
    }
} -result {}

test accounts-redirect {An anonymous protected page redirects to sign-in with the original destination} -body {
    list [::accountstest::request GET /user/profile?tab=security] \
        [dict get $::accountstest::last headers Location] \
        [::accountstest::request HEAD /user] [dict get $::accountstest::last body]
} -result {302 /user/login?return_to=%2Fuser%2Fprofile%3Ftab%3Dsecurity 302 {}}

test accounts-local-origins {Browser registration accepts localhost and loopback addresses on local ports} -body {
    set result {}
    set number 0
    foreach origin {http://localhost:8080 http://127.0.0.1:8080 http://localhost:8181 http://127.0.0.1:8181} {
        set ::accountstest::origin $origin
        set ::accountstest::cookie {}
        set ::accountstest::csrf {}
        ::accountstest::request GET /user/register
        regexp {name="captcha_id" value="([^"]+)"} [dict get $::accountstest::last body] -> id
        lappend result [::accountstest::request POST /user/register [dict create \
            email loopback[incr number]@example.com password abcdef first_name Local last_name Member \
            captcha_id $id captcha_answer $::accountstest::answer]]
        lappend result [string match {*action="/user/verify"*} [dict get $::accountstest::last body]]
    }
    set result
} -cleanup {
    set ::accountstest::origin http://localhost:8080
    set ::accountstest::cookie {}
    set ::accountstest::csrf {}
} -result {200 1 200 1 200 1 200 1}

test accounts-lambda-registration {Lambda payloads preserve cookies through registration, verification and login} -body {
    set result {}
    set number 0
    foreach {version extras} {2.0 {} 2.0 {theme=dark} 1.0 {theme=dark}} {
        set ::accountstest::lambdaVersion $version
        set ::accountstest::extraCookies $extras
        set ::accountstest::origin http://127.0.0.1:8080
        set ::accountstest::cookie {}
        set ::accountstest::csrf {}
        set email lambda[incr number]@example.com
        set suffix ?return_to=%2Fdocs
        ::accountstest::request GET /user/register$suffix
        regexp {name="captcha_id" value="([^"]+)"} [dict get $::accountstest::last body] -> id
        lappend result [::accountstest::request POST /user/register$suffix [dict create \
            email $email password abcdef first_name Lambda last_name Member \
            captcha_id $id captcha_answer $::accountstest::answer]]
        regexp {id="local-code">([0-9]+)</code>} [dict get $::accountstest::last body] -> code
        lappend result [::accountstest::request POST /user/verify$suffix [dict create code $code]] \
            [::accountstest::request POST /user/login$suffix [dict create email $email password abcdef]] \
            [dict get $::accountstest::last headers Location]
        lappend result [::accountstest::request GET /user] \
            [string match {*class="pure-menu-link">Account</a>*} [dict get $::accountstest::last body]]
    }
    set result
} -cleanup {
    set ::accountstest::lambdaVersion {}
    set ::accountstest::extraCookies {}
    set ::accountstest::origin http://localhost:8080
    set ::accountstest::cookie {}
    set ::accountstest::csrf {}
} -result {200 200 302 /docs 200 1 200 200 302 /docs 200 1 200 200 302 /docs 200 1}

test accounts-submit-script {login and registration load the fingerprinted script with CDN permission} -setup {
    set savedCdn $::assets::cdn_origin
    set ::assets::cdn_origin https://cdn.example
} -body {
    set result {}
    foreach path {/user/login /user/register} {
        lappend result [::accountstest::request GET $path]
        set html [dict get $::accountstest::last body]
        lappend result [expr {[string first [dict get $::assets::manifest /js/account-forms.js] $html] >= 0}] \
            [string match {*script-src 'self' https://cdn.example*} [::responses::header $::accountstest::last Content-Security-Policy]]
    }
    set result
} -cleanup {
    set ::assets::cdn_origin $savedCdn
} -result {200 1 1 200 1 1}

test accounts-register {real registration uses the shared layout, CAPTCHA and requested password minimum} -body {
    set result [list [::accountstest::request GET /user/register]]
    set html [dict get $::accountstest::last body]
    regexp {name="captcha_id" value="([^"]+)"} $html -> id
    lappend result [expr {[string first {class="account-button"} $html] >= 0}] \
        [expr {[string first {class="site-header"} $html] >= 0}] \
        [expr {[string first {minlength="6"} $html] >= 0}] \
        [::responses::header $::accountstest::last Cache-Control]
    lappend result [::accountstest::request POST /user/register [dict create email site@example.com password abcdef \
        first_name Site last_name Member captcha_id $id captcha_answer $::accountstest::answer]]
    regexp {id="local-code">([0-9]+)</code>} [dict get $::accountstest::last body] -> code
    lappend result [::accountstest::request POST /user/verify [dict create code $code]] \
        [::accountstest::request POST /user/login {email site@example.com password abcdef}]
    lappend result [string match {*class="pure-menu-link">Account</a>*} [dict get $::accountstest::last body]]
    set result
} -result {200 1 1 1 no-store 200 200 200 1}

test accounts-shared-query-count {authentication, handler and navigation share identity reads across mounted pages} -body {
    proc count_account_queries {args} {incr ::account_queries}
    set result {}
    foreach path {/forum /docs /blog /user/} {
        set ::account_queries 0
        trace add execution ::tpersist::db_execute enter count_account_queries
        try {set status [::accountstest::request GET $path]} finally {
            trace remove execution ::tpersist::db_execute enter count_account_queries
        }
        lappend result $status $::account_queries
    }
    set result
} -cleanup {rename count_account_queries {}; unset ::account_queries} -result {200 5 200 4 200 4 200 5}

test accounts-monitor-access {Monitor paths enforce live grants and public footers omit the monitor link} -setup {
    set savedCookie $::accountstest::cookie
} -body {
    set checks {}
    foreach version {{} 1.0 2.0} {
        set ::accountstest::lambdaVersion $version
        foreach group {admin observer} {
            foreach allowed {0 1 0} {
                set grant [expr {$allowed ? "request_monitor.view" : "forum.moderate"}]
                ::web::user::sync_access $::accounts::store [dict create $group site@example.com] [dict create $group $grant]
                foreach path {/ /docs /blog /user /forum} {
                    ::accountstest::request GET $path
                    lappend checks [expr {![string match {*href="/request-monitor"*} [dict get $::accountstest::last body]]}]
                }
                foreach path {/request-monitor /request-monitor/ /request-monitor/recent /request-monitor/_assets/charts.js} {
                    foreach method {GET HEAD} {
                        lappend checks [expr {[::accountstest::request $method $path] == ($allowed ? 200 : 403)}]
                        if {!$allowed} {
                            lappend checks [expr {[::responses::header $::accountstest::last Cache-Control] eq "no-store"}]
                        }
                    }
                }
            }
        }
        set ::accountstest::cookie {}
        lappend checks [expr {[::accountstest::request GET /request-monitor] == 403}]
        ::accountstest::request GET /
        lappend checks [expr {![string match {*href="/request-monitor"*} [dict get $::accountstest::last body]]}]
        set ::accountstest::cookie $savedCookie
    }
    lsort -unique $checks
} -cleanup {
    set ::accountstest::lambdaVersion {}
    set ::accountstest::cookie $savedCookie
    # Exercise the default admin grant through the real configured sync task.
    dict set ::site::settings account access groups admin site@example.com
    ::accounts::sync_access
} -result 1

test accounts-dashboard-access {Dashboard access and individual tool links follow independent live grants} -setup {
    set savedCookie $::accountstest::cookie
} -body {
    foreach version {{} 1.0 2.0} {
        set ::accountstest::lambdaVersion $version
        set ::accountstest::cookie {}
        foreach method {GET HEAD} {
            if {[::accountstest::request $method /admin] != 302 ||
                [::responses::header $::accountstest::last Location] ne "/user/login?return_to=%2Fadmin" ||
                [::responses::header $::accountstest::last Cache-Control] ne "no-store"} {
                error "$method /admin did not redirect a guest to sign in"
            }
        }
        set ::accountstest::cookie $savedCookie
        foreach grants {
            {request_monitor.view users.manage}
            {admin_dashboard.manage}
            {admin_dashboard.manage request_monitor.view}
            {admin_dashboard.manage users.manage}
            {admin_dashboard.manage users.manage request_monitor.view}
            {}
        } {
            ::web::user::sync_access $::accounts::store {operator site@example.com} [dict create operator [join $grants ,]]
            set allowed [expr {"admin_dashboard.manage" in $grants}]
            foreach path {/user /user/} {
                set status [::accountstest::request GET $path]
                set body [dict get $::accountstest::last body]
                if {$status != 200 || [string match {*href="/admin">Admin dashboard*} $body] != $allowed ||
                    [string match {*href="/user/admin/users"*} $body]} {
                    error "Incorrect account navigation on $path with grants: $grants"
                }
            }
            foreach method {GET HEAD} {
                set status [::accountstest::request $method /admin]
                set body [dict get $::accountstest::last body]
                if {$status != ($allowed ? 200 : 403) || [::responses::header $::accountstest::last Cache-Control] ne "no-store"} {
                    error "Incorrect $method /admin response with grants: $grants"
                }
                if {$method eq "HEAD" && $body ne {}} {error "HEAD /admin returned a body"}
                if {$method eq "GET" && $allowed} {
                    foreach {permission path} {request_monitor.view /request-monitor users.manage /user/admin/users} {
                        if {([string first "href=\"$path\"" $body] >= 0) != ($permission in $grants)} {
                            error "Incorrect dashboard link to $path with grants: $grants"
                        }
                    }
                }
            }
        }
    }
} -cleanup {
    set ::accountstest::lambdaVersion {}
    set ::accountstest::cookie $savedCookie
    ::accounts::sync_access
} -result {}

test accounts-recent-requests {The authorized page shows only the last hundred requests and escapes paths and user agents} -body {
    set ::treqmon::worker::memstore::recent_requests {}
    ::accountstest::request GET /request-monitor/recent
    set empty [string match {*No requests have been recorded yet.*} [dict get $::accountstest::last body]]
    for {set i 0} {$i < 105} {incr i} {
        ::site::dispatch $::site::router [dict create method GET path /recent-probe-$i \
            headers [dict create User-Agent {<script>alert("agent")</script>}]] {addr 203.0.113.4}
    }
    ::site::dispatch $::site::router [dict create method GET path {/<img src=x onerror=alert(1)>} headers {}] {addr 203.0.113.5}
    set status [::accountstest::request GET /request-monitor/recent]
    set html [dict get $::accountstest::last body]
    ::accountstest::request GET /request-monitor
    list $empty $status [regexp -all {<tr>} $html] \
        [expr {[string first 203.0.113.4 $html] >= 0}] \
        [expr {[string first {&lt;script&gt;} $html] >= 0 && [string first {<script>alert} $html] < 0}] \
        [expr {[string first {&lt;img} $html] >= 0 && [string first {<img src=x} $html] < 0}] \
        [expr {[string first /recent-probe-104 $html] < [string first /recent-probe-6 $html]}] \
        [expr {[string first {/recent-probe-5<} $html] < 0}] \
        [string match {*href="/request-monitor/recent">Last 100 requests*} [dict get $::accountstest::last body]]
} -result {1 200 101 1 1 1 1 1 1}

test accounts-monitor {Direct and Lambda requests count one account across multiple sessions} -setup {
    set savedCookie $::accountstest::cookie
    set uid [dict get [::web::user::current_user $::accounts::mount \
        [dict create headers [dict create cookie $savedCookie]]] id]
    set token [::web::user::new_session $::accounts::store auth $uid]
    set issued [::web::user::set_cookie $::accounts::mount {statusCode 200 headers {} body {}} $token]
    set secondCookie [lindex [split [dict get $issued headers Set-Cookie] {;}] 0]
    set ::treqmon::middleware::accountsteststore::history {}
} -body {
    set statuses {}
    foreach version {{} 1.0 2.0} {
        set ::accountstest::lambdaVersion $version
        foreach cookie [list $savedCookie $secondCookie] {
            set ::accountstest::cookie $cookie
            lappend statuses [::accountstest::request GET /docs]
        }
    }
    set events [::treqmon::get_history_events]
    set active [dict get [::treqmon::get_active_users $events] minute active_users]
    set identities [lsort -unique [lmap event $events {lindex $event 2}]]
    ::accountstest::request GET /request-monitor
    list [lsort -unique $statuses] [llength $events] [expr {$identities eq [list $uid]}] \
        [lsort -unique [lmap {bucket values} $active {lindex $values 1}]] \
        [string match {*Active Users*} [dict get $::accountstest::last body]]
} -cleanup {
    ::web::user::consume $::accounts::store [::web::user::session $::accounts::store $token]
    set ::accountstest::lambdaVersion {}
    set ::accountstest::cookie $savedCookie
} -result {200 6 1 1 1}

test accounts-monitor-guests {Anonymous, pending, expired and revoked cookies do not count as active users} -setup {
    set savedCookie $::accountstest::cookie
    set uid [dict get [::web::user::current_user $::accounts::mount \
        [dict create headers [dict create cookie $savedCookie]]] id]
    set cookies [list {} [dict get $::accounts::mount -cookie]=invalid]
    foreach kind {anon two-factor auth auth} state {live pending expired revoked} {
        set token [::web::user::new_session $::accounts::store $kind $uid]
        set issued [::web::user::set_cookie $::accounts::mount {statusCode 200 headers {} body {}} $token]
        lappend cookies [lindex [split [dict get $issued headers Set-Cookie] {;}] 0]
        set row [::web::user::session $::accounts::store $token]
        if {$state eq "expired"} {
            ::tsession::sql::update [dict get $::accounts::store -sessions] [dict get $row id] \
                [dict create expires [expr {[clock seconds] - 1}]]
        } elseif {$state eq "revoked"} {
            ::web::user::consume $::accounts::store $row
        }
    }
    set ::treqmon::middleware::accountsteststore::history {}
} -body {
    foreach cookie $cookies {
        set ::accountstest::cookie $cookie
        ::accountstest::request GET /docs
    }
    # An inbound legacy session field must not bypass web-user authentication.
    ::site::dispatch $::site::router {method GET path /docs session {loggedin true id forged}}
    set events [::treqmon::get_history_events]
    list [llength $events] [lsort -unique [lmap event $events {lindex $event 2}]] \
        [dict get [::treqmon::get_active_users $events] minute active_users]
} -cleanup {
    set ::accountstest::cookie $savedCookie
} -result {7 {{}} {}}

test accounts-members {Signed-in navigation follows the session and changes back immediately on logout} -body {
    set result {}
    foreach path {/ /docs /blog /user} {
        ::accountstest::request GET $path
        set html [dict get $::accountstest::last body]
        lappend result [string match {*class="pure-menu-link">Account</a>*} $html] \
            [expr {![string match {*class="pure-menu-link">Sign in</a>*} $html]}] \
            [expr {[::responses::header $::accountstest::last Cache-Control] eq "no-store"}]
    }
    ::accountstest::request POST /user/logout
    lappend result [string match {*class="pure-menu-link">Sign in</a>*} [dict get $::accountstest::last body]]
    ::accountstest::request GET /
    lappend result [string match {*class="pure-menu-link">Sign in</a>*} [dict get $::accountstest::last body]]
    lappend result [expr {[lindex [lindex [::treqmon::get_history_events] end] 2] eq {}}]
    lsort -unique $result
} -result 1

test accounts-persistence {Lambda login redirects preserve opt-in cookie lifetime and default to browser sessions} -body {
    set result {}
    foreach version {1.0 2.0} {
        set ::accountstest::lambdaVersion $version
        foreach remember {0 1} {
            set ::accountstest::cookie {}
            set ::accountstest::csrf {}
            ::accountstest::request GET /user/login
            regexp {<input type="checkbox" name="stay_signed_in"[^>]*>} [dict get $::accountstest::last body] input
            lappend result [expr {[string first checked $input] < 0}]
            set fields {email site@example.com password abcdef}
            if {$remember} {dict set fields stay_signed_in 1}
            lappend result [::accountstest::request POST /user/login?return_to=%2Fdocs $fields] \
                [dict get $::accountstest::last headers Location]
            set age -1
            regexp {; Max-Age=([0-9]+)} [dict get $::accountstest::last headers Set-Cookie] -> age
            lappend result [expr {$remember ? ($age > 2591990 && $age <= 2592000) : $age == -1}] \
                [::accountstest::request GET /user]
            ::accountstest::request POST /user/logout
        }
    }
    set result
} -cleanup {
    set ::accountstest::lambdaVersion {}
    set ::accountstest::cookie {}
    set ::accountstest::csrf {}
} -result {1 302 /docs 1 200 1 302 /docs 1 200 1 302 /docs 1 200 1 302 /docs 1 200}

test accounts-recovery {forgotten-password renders CAPTCHA and the scheduler can invoke bounded cleanup} -body {
    set status [::accountstest::request GET /user/forgot]
    set maintenance [::tjson::json_to_simple [::site_lambda::handle {{"source":"ttrek.patch","task":"task_prune_accounts"}} {}]]
    list $status [expr {[string first {name="captcha_id"} [dict get $::accountstest::last body]] >= 0}] \
        [dict get $maintenance ok] [llength [dict get $maintenance completed]]
} -result {200 1 1 4}

test accounts-form-errors {direct and Lambda failures render account forms with the shared site layout and permit recovery retries} -body {
    set result {}
    foreach version {{} 1.0 2.0} {
        set ::accountstest::lambdaVersion $version
        set ::accountstest::cookie {}
        set ::accountstest::csrf {}
        ::accountstest::request GET /user/login?return_to=%2Fdocs
        set fields {email nobody@example.com password wrong-password-secret stay_signed_in 1}
        if {[regexp {name="captcha_id" value="([^"]+)"} [dict get $::accountstest::last body] -> id]} {
            dict set fields captcha_id $id
            dict set fields captcha_answer $::accountstest::answer
        }
        lappend result [::accountstest::request POST /user/login?return_to=%2Fdocs $fields]
        set html [dict get $::accountstest::last body]
        lappend result [::responses::header $::accountstest::last Content-Type] \
            [string match {*class="site-header"*} $html] \
            [string match {*action="/user/login?return_to=%2Fdocs"*} $html] \
            [string match {*Invalid email or password.*} $html] \
            [expr {[string first wrong-password-secret $html] < 0}]
        ::accountstest::request GET /user/forgot
        lappend result [::accountstest::request POST /user/forgot {email not-an-email}]
        set html [dict get $::accountstest::last body]
        lappend result [string match {*action="/user/forgot"*} $html] \
            [string match {*value="not-an-email"*} $html]
        regexp {name="captcha_id" value="([^"]+)"} $html -> id
        lappend result [::accountstest::request POST /user/forgot [dict create email nobody@example.com \
            captcha_id $id captcha_answer $::accountstest::answer]]
    }
    set result
} -cleanup {
    set ::accountstest::lambdaVersion {}
    set ::accountstest::cookie {}
    set ::accountstest::csrf {}
} -result {401 {text/html; charset=utf-8} 1 1 1 1 400 1 1 200 401 {text/html; charset=utf-8} 1 1 1 1 400 1 1 200 401 {text/html; charset=utf-8} 1 1 1 1 400 1 1 200}

test accounts-close-account {direct and Lambda account closure confirms the password and immediately updates navigation} -body {
    set result {}
    set serial 0
    foreach version {{} 1.0 2.0} {
        set ::accountstest::lambdaVersion $version
        set ::accountstest::cookie {}
        set ::accountstest::csrf {}
        set email close[incr serial]@example.com
        ::accountstest::request GET /user/register
        regexp {name="captcha_id" value="([^"]+)"} [dict get $::accountstest::last body] -> id
        ::accountstest::request POST /user/register [dict create email $email password abcdef \
            first_name Closing last_name Member captcha_id $id captcha_answer $::accountstest::answer]
        regexp {id="local-code">([0-9]+)</code>} [dict get $::accountstest::last body] -> code
        ::accountstest::request POST /user/verify [dict create code $code]
        ::accountstest::request GET /user/login
        set fields [dict create email $email password abcdef]
        if {[regexp {name="captcha_id" value="([^"]+)"} [dict get $::accountstest::last body] -> id]} {
            dict set fields captcha_id $id
            dict set fields captcha_answer $::accountstest::answer
        }
        lappend result [::accountstest::request POST /user/login $fields] \
            [string match {*class="account-danger" href="/user/close-account">Close account*} [dict get $::accountstest::last body]] \
            [::accountstest::request GET /user/close-account]
        set html [dict get $::accountstest::last body]
        lappend result [string match {*class="account-button account-button-danger"*} $html] \
            [string match {*name="current_password" type="password"*} $html] \
            [string match {*This cannot be undone.*} $html] \
            [::accountstest::request POST /user/close-account {current_password wrong}]
        set html [dict get $::accountstest::last body]
        lappend result [string match {*Invalid current password.*action="/user/close-account"*} $html] \
            [::accountstest::request POST /user/close-account {current_password abcdef}]
        set html [dict get $::accountstest::last body]
        lappend result [string match {*Your account has been closed.*} $html] \
            [string match {*class="pure-menu-link">Sign in</a>*} $html] \
            [expr {![string match {*class="pure-menu-link">Account</a>*} $html]}] \
            [expr {[::web::user::user_by_email $::accounts::store $email] eq {}}] \
            [::accountstest::request GET /user]
    }
    set result
} -cleanup {
    set ::accountstest::lambdaVersion {}
    set ::accountstest::cookie {}
    set ::accountstest::csrf {}
} -result {200 1 200 1 1 1 401 1 200 1 1 1 1 302 200 1 200 1 1 1 401 1 200 1 1 1 1 302 200 1 200 1 1 1 401 1 200 1 1 1 1 302}

test accounts-local-ses {local verification uses the configured loopback service and formatted account email} -setup {
    package require pure-tcl-aws-ses
    set localDisplay [dict get [::app_config::account {} $root $work] display]
    set localMail [dict replace $::accounts::mount -config $localDisplay -deliver [dict get $localDisplay deliver]]
    set savedPort [array get ::env TTREK_LOCAL_SES_PORT]
    set ::env(TTREK_LOCAL_SES_PORT) 42345
    rename ::aws::ses::create ::accountstest::real_ses_create
    proc ::aws::ses::create {options} {set ::sesOptions $options; return ::accountstest::capture_mail}
    proc ::accountstest::capture_mail {method args} {if {$method eq "send_email"} {set ::sesMessage [lindex $args 0]}}
} -body {
    ::web::user::deliver $localMail verify member@example.com 012345
    list [dict get $::sesOptions endpoint] [dict get $::sesOptions aws_access_key_id] \
        [dict get $::sesMessage to] [string match {*012345*} [dict get $::sesMessage text]]
} -cleanup {
    rename ::aws::ses::create {}
    rename ::accountstest::real_ses_create ::aws::ses::create
    rename ::accountstest::capture_mail {}
    unset ::env(TTREK_LOCAL_SES_PORT)
    array set ::env $savedPort
} -result {http://127.0.0.1:42345 local member@example.com 1}

test accounts-ses {production configuration sends verification and recovery through the configured SES sender} -setup {
    package require tconfig::decrypt
    package require pure-tcl-aws-ses 1.0.0
    rename ::aws::ses::create ::accountstest::real_ses_create
    # Capture SES client configuration without contacting AWS.
    proc ::aws::ses::create {options} {
        set ::accountstest::ses_options $options
        return ::accountstest::ses_client
    }
    # Capture the outgoing message and require the caller to release its client.
    proc ::accountstest::ses_client {method args} {
        if {$method eq "send_email"} {set ::accountstest::ses_message [lindex $args 0]}
        if {$method eq "destroy"} {set ::accountstest::ses_destroyed 1}
    }
} -body {
    set ::env(ENV) PROD
    set input [::tconfig::read_config [file join $root devops config.prod.ini]]
    # Direct SES remains supported when queueing is explicitly disabled.
    dict set input account email_queue_enabled false
    dict for {key value} [dict get $account secret_config] {dict set input account $key $value}
    set production [::app_config::account $input $root]
    set mail [dict create -store [dict replace $::accounts::store -env PROD] \
        -config [dict get $production display] -prefix [dict get $production display prefix] -deliver {}]
    ::web::user::validate_email_config $mail
    set result [list [dict get $production policy email_verification_required] \
        [dict get $production policy verification_emails_enabled] [dict get $production display email_enabled]]
    foreach purpose {verify reset} {
        set ::accountstest::ses_destroyed 0
        ::web::user::deliver $mail $purpose member@example.com 012345
        set message $::accountstest::ses_message
        lappend result [list [dict get $::accountstest::ses_options region] [dict get $message from] \
            [dict get $message to] [string match {*012345*} [dict get $message text]] $::accountstest::ses_destroyed]
    }
    set result
} -cleanup {
    set ::env(ENV) LOCAL
    rename ::aws::ses::create {}
    rename ::accountstest::real_ses_create ::aws::ses::create
    rename ::accountstest::ses_client {}
} -result {true true true {eu-central-1 noreply@ttrek.sh member@example.com 1 1} {eu-central-1 noreply@ttrek.sh member@example.com 1 1}}

test accounts-email-queue-config {SSM String and SecureString queue URLs reach mounted web-user delivery} -setup {
    package require tconfig::encrypt
    package require tconfig::decrypt
    package require pure-tcl-aws-sqs 1.0.0
    set queueKey [::tink::register_keyset [::tink::aead::create_keyset AES256_GCM]]
    set queueRouter [::tpathexp::router]
    rename ::aws::sqs::create ::accountstest::real_sqs_create
    proc ::aws::sqs::create {options} {
        set ::accountstest::sqs_region [dict get $options region]
        return ::accountstest::sqs_client
    }
    proc ::accountstest::sqs_client {method args} {
        switch -- $method {
            send_message {set ::accountstest::sqs_url [lindex $args 0]}
            destroy {}
            default {error "Unexpected SQS call: $method"}
        }
    }
    proc ::accountstest::ssm_queue {method path decrypt} {
        if {$method ne "get_parameter" || $path ne "/ttrek_sh/prod/account/email_queue_url" || !$decrypt} {
            error "No test parameter"
        }
        dict create type $::accountstest::ssm_type value https://sqs.eu-central-1.amazonaws.com/123456789012/user-emails
    }
} -body {
    set ::env(ENV) PROD
    set result {}
    foreach type {String SecureString} {
        set ::accountstest::ssm_type $type
        set input [::tconfig::read_config [file join $root devops config.prod.ini]]
        set encrypted [::tconfig::encrypt_dict $input ::accountstest::ssm_queue $queueKey {application ttrek_sh environment prod}]
        lappend result [dict exists $encrypted account enc:email_queue_url]
        set input [::tconfig::decrypt_dict $encrypted $queueKey]
        dict for {key value} [dict get $account secret_config] {dict set input account $key $value}
        set production [::app_config::account $input $root]
        set display [dict get $production display]
        dict set display prefix /queue-$type
        dict set display google_enabled false
        set mail [::web::user::mount $queueRouter -store [dict replace $::accounts::store -env PROD] -config $display]
        ::web::user::deliver $mail verify member@example.com 012345
        lappend result $::accountstest::sqs_region $::accountstest::sqs_url
    }
    set result
} -cleanup {
    set ::env(ENV) LOCAL
    $queueRouter destroy
    ::tink::unregister_keyset $queueKey
    rename ::aws::sqs::create {}
    rename ::accountstest::real_sqs_create ::aws::sqs::create
    rename ::accountstest::sqs_client {}
    rename ::accountstest::ssm_queue {}
} -result {0 eu-central-1 https://sqs.eu-central-1.amazonaws.com/123456789012/user-emails 1 eu-central-1 https://sqs.eu-central-1.amazonaws.com/123456789012/user-emails}

test accounts-email-login {site email-code sign-in verifies an unverified account, uses CAPTCHA and preserves return_to} -setup {
    set savedCookie $::accountstest::cookie
    set savedCsrf $::accountstest::csrf
    set ::accountstest::cookie {}; set ::accountstest::csrf {}
    set store $::accounts::store
    set uid user_[::ksuid::generate_ksuid]
    set email code-login@example.com
    ::web::user::insert $store web_user_users [dict create id $uid active 1 verified 0 \
        email_key [::web::user::email_key $store $email] email [::web::user::seal $store $email [list email $uid]] \
        password {} mfa_secret {} last_step -1 revision 0 created_at [clock seconds]]
} -body {
    set result [list [::accountstest::request GET /user/login]]
    lappend result [string match {*Login</h1>*Email me a one-time code*OR*Email <input*Password <input*} [dict get $::accountstest::last body]]
    lappend result [::accountstest::request GET /user/email-login?return_to=%2Fdocs]
    lappend result [::accountstest::request POST /user/email-login?return_to=%2Fdocs [dict create email $email]]
    regexp {name="captcha_id" value="([^"]+)"} [dict get $::accountstest::last body] -> id
    lappend result [::accountstest::request POST /user/email-login?return_to=%2Fdocs [dict create \
        email $email captcha_id $id captcha_answer $::accountstest::answer]]
    lappend result [dict get [::web::user::user_by_id $store $uid] verified]
    regexp {id="local-code">([0-9]+)</code>} [dict get $::accountstest::last body] -> code
    lappend result [::accountstest::request POST /user/email-login/verify?return_to=%2Fdocs [dict create code $code]] \
        [dict get $::accountstest::last headers Location] \
        [expr {[dict get [::web::user::user_by_id $store $uid] last_email_login_at] > 0}] \
        [dict get [::web::user::user_by_id $store $uid] verified]
    set result
} -cleanup {
    ::web::user::revoke $store $uid
    ::web::user::remove $store web_user_users [dict create id $uid]
    set ::accountstest::cookie $savedCookie
    set ::accountstest::csrf $savedCsrf
} -result {200 1 200 400 200 0 302 /docs 1 1}

rename ::tcaptcha::image {}
rename ::tcaptcha::site_test_image ::tcaptcha::image
$::site::router destroy
::tpersist::db_disconnect $db
::web::user::release $::accounts::mount
set ::accounts::mount {}
removeDirectory $work
set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
