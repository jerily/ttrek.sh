package require Tcl 9.1
set ::env(ENV) LOCAL
package require tcltest 2
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root tcl site.tcl]
source [file join $root tcl config.tcl]
source [file join $root tcl telemetry.tcl]
::telemetry::init_local {dialect sqlite database :memory:} [list [file join $root registry]]
set settings [dict create rootdir $root registry_dir [file join $root registry] releases [::app_config::releases {}] \
    content_connection $::telemetry::connection content_images {} treqmon {store {tsvstore {history_max_events 100}}}]
foreach {kind directory} {wiki docs blog blog} {
    ::web::static::${kind}::initdb $::telemetry::connection
    set store [dict get [::content_images::database_stores $::telemetry::connection {}] $kind]
    ::web::static::${kind}::sync $store [file join $root content $directory]
}
::site::init_worker $settings
proc request {path {method GET} {headers {}}} {
    ::site::dispatch $::site::router [dict create method $method path $path headers $headers]
}
test static-1 {documentation and blog mount with the host layout} -body {
    set docs [request /docs/getting-started]
    set blog [request /blog]
    list [dict get $docs statusCode] [string match {*ttrek init -y*} [dict get $docs body]] \
        [dict get $blog statusCode] [string match {*ttrek 1.0.0 is now public*} [dict get $blog body]] \
        [string match {*href="/blog"*} [dict get $docs body]]
} -result {200 1 200 1 1}
test static-2 {homepage has documentation and blog navigation without signup} -body {
    set html [dict get [request /] body]
    list [string match {*href="/docs"*} $html] [string match {*href="/blog"*} $html] \
        [string match {*Sign Up*} $html]
} -result {1 1 0}
test static-3 {authoring routes cannot be enabled by environment variables} -body {
    set ::env(TTREK_EDITOR_PASSWORD) arbitrary
    set ::env(TTREK_LOCAL_EDIT_DATABASE) /missing
    set codes {}
    foreach path {/docs/_new /docs/_edit/getting-started /blog/_new /blog/_edit/post /docs/_assets/editor.css} {
        lappend codes [dict get [request $path] statusCode]
    }
    foreach path {/docs /docs/_new /blog /blog/_edit/post} {
        lappend codes [dict get [request $path POST] statusCode]
    }
    set codes
} -cleanup {
    unset ::env(TTREK_EDITOR_PASSWORD) ::env(TTREK_LOCAL_EDIT_DATABASE)
} -result {404 404 404 404 404 405 405 405 405}
test static-4 {HEAD and safe content headers} -body {
    set response [request /docs/getting-started HEAD]
    list [dict get $response statusCode] [dict get $response body] \
        [dict get $response headers x-content-type-options]
} -result {200 {} nosniff}
test static-5 {The package-owned monitor uses the shared site layout and assets} -body {
    set response [request /request-monitor]
    set html [dict get $response body]
    list [dict get $response statusCode] [regexp -all {<canvas } $html] \
        [string match {*class="site-header"*} $html] [expr {[string first [::assets::url /css/site.css] $html] >= 0}] \
        [string match {*class="footer is-center"*} $html] \
        [string match {*<title>Request Monitor · ttrek</title>*} $html] \
        [string match {*src="/request-monitor/_assets/charts.js"*} $html] \
        [dict get [request /request-monitor/_assets/charts.js] statusCode] \
        [dict get [request /request-monitor HEAD] body] \
        [dict get [request /request-monitor POST] statusCode]
} -result {200 6 1 1 1 1 1 200 {} 405}
test static-6 {The configured monitor master is passed to the package mount} -setup {
    set router [::tpathexp::router]
} -body {
    ::site::configure [dict replace $settings request_monitor {master_template blog-master.html.jinja}]
    ::site::mount $router
    set html [dict get [::site::dispatch $router {method GET path /request-monitor}] body]
    list [string match {*class="site-main documentation"*} $html] [regexp -all {<canvas } $html]
} -cleanup {
    $router destroy
    ::site::configure $settings
} -result {1 6}
test static-7 {A missing monitor master fails before the server begins dispatching} -setup {
    set router [::tpathexp::router]
} -body {
    ::site::configure [dict replace $settings request_monitor {master_template missing.html.jinja}]
    ::site::mount $router
} -cleanup {
    $router destroy
    ::site::configure $settings
} -returnCodes error -match glob -result {*missing.html.jinja*}
test assets-fixed {Fixed assets carry the manifest fingerprint as their ETag and must revalidate} -body {
    set response [request /css/styles.css]
    set bytes [::assets::read_bytes [file join $root public css styles.css]]
    regexp {\.([0-9a-f]{16})\.css$} [::assets::url /css/styles.css] -> hash
    list [dict get $response statusCode] [dict get $response headers Cache-Control] \
        [dict get $response headers content-type] \
        [expr {[binary decode base64 [dict get $response body]] eq $bytes}] \
        [expr {[dict get $response headers ETag] eq "\"sha256-$hash\""}]
} -result {200 no-cache text/css 1 1}

test assets-favicon {Both favicon formats serve exact bytes and cache for 90 days} -body {
    set results {}
    foreach {path type} {/assets/favicon.svg image/svg+xml /favicon.ico image/vnd.microsoft.icon} {
        set response [request $path]
        set bytes [::assets::read_bytes [file join $root public [string trimleft $path /]]]
        lappend results [list [dict get $response statusCode] [dict get $response headers Cache-Control] \
            [expr {[dict get $response headers content-type] eq $type}] \
            [expr {[binary decode base64 [dict get $response body]] eq $bytes}] \
            [dict exists $response headers ETag]]
    }
    lsort -unique $results
} -result {{200 {public, max-age=7776000} 1 1 0}}

test assets-favicon-conditional {Favicons without manifest fingerprints preserve HEAD and cache policy without ETags} -body {
    set results {}
    foreach path {/assets/favicon.svg /favicon.ico} {
        set get [request $path]
        set head [request $path HEAD]
        set conditional [request $path HEAD {If-None-Match {"old"}}]
        lappend results [list [dict get $head statusCode] [dict get $head body] \
            [expr {[dict get $head headers] eq [dict get $get headers]}] \
            [dict get $conditional statusCode] [dict get $conditional body] \
            [dict get $conditional headers Cache-Control]]
    }
    lsort -unique $results
} -result {{200 {} 1 200 {} {public, max-age=7776000}}}

test assets-conditional {Strong, weak, list and wildcard validators return empty 304s} -body {
    set etag [dict get [request /css/styles.css] headers ETag]
    set result {}
    foreach validator [list $etag W/$etag "\"old\", W/$etag" * " , $etag , "] {
        set response [request /css/styles.css GET [dict create If-None-Match $validator]]
        lappend result [list [dict get $response statusCode] [dict get $response body] \
            [expr {[dict get $response headers ETag] eq $etag}] [dict get $response headers Cache-Control]]
    }
    lsort -unique $result
} -result {{304 {} 1 no-cache}}

test assets-nonmatching {Nonmatching or malformed validators do not suppress content} -body {
    set etag [dict get [request /css/styles.css] headers ETag]
    set result {}
    foreach validator [list {"old"} {} [string trim $etag \"] "garbage, $etag" "$etag garbage" "\"prefix,$etag\""] {
        lappend result [dict get [request /css/styles.css GET [dict create if-none-match $validator]] statusCode]
    }
    lsort -unique $result
} -result 200

test assets-repeated {Repeated header fields use the complete validator list} -body {
    set etag [dict get [request /css/styles.css] headers ETag]
    set response [::site::dispatch $::site::router [dict create method GET path /css/styles.css \
        headers {if-none-match {"old"}} multiValueHeaders [dict create If-None-Match [list {"old"} W/$etag]]]]
    dict get $response statusCode
} -result 304

test assets-versioned {Every manifest URL serves exact bytes with immutable caching} -body {
    set results {}
    dict for {original versioned} $::assets::manifest {
        set response [request $versioned]
        lappend results [list [dict get $response statusCode] [dict get $response headers Cache-Control] \
            [expr {[dict get $response body] eq [dict get [request $original] body]}]]
    }
    lsort -unique $results
} -result {{200 {public, max-age=31536000, immutable} 1}}

test assets-head {HEAD uses GET cache headers and never returns a body, including 304} -body {
    set path [::assets::url /js/search.js]
    set get [request $path]
    set head [request $path HEAD]
    set conditional [request $path HEAD [dict create if-none-match [dict get $get headers ETag]]]
    list [dict get $head statusCode] [dict get $head body] \
        [expr {[dict get $head headers] eq [dict get $get headers]}] \
        [dict get $conditional statusCode] [dict get $conditional body] \
        [dict get $conditional headers Cache-Control]
} -result {200 {} 1 304 {} {public, max-age=31536000, immutable}}

test assets-missing {Wildcard conditions cannot turn a missing asset into a 304} -body {
    set results {}
    foreach path {/css/missing.css /assets/versioned/js/missing.0123456789abcdef.js /assets/missing.txt} {
        set response [request $path GET {if-none-match *}]
        lappend results [list [dict get $response statusCode] [dict get $response headers Cache-Control] \
            [dict exists $response headers ETag]]
    }
    lsort -unique $results
} -result {{404 no-store 0}}

test assets-fingerprint {Versioned assets use the filename fingerprint without checking their bytes} -body {
    set response [::assets::respond /assets/versioned/css/example.0000000000000000.css \
        {headers {if-none-match *}} text/css [encoding convertto utf-8 {changed bytes}]]
    list [dict get $response statusCode] [dict get $response headers Cache-Control] \
        [dict get $response headers ETag] [binary decode base64 [dict get $response body]]
} -result {200 {public, max-age=31536000, immutable} {"sha256-0000000000000000"} {changed bytes}}

test assets-bytes {Manifest ETags stay fixed until a rebuild while requests serve the supplied bytes} -body {
    set a [binary format H* 00ff0d0a]
    set b [binary format H* 00fe0d0a]
    set first [::assets::respond /css/styles.css {} text/css $a]
    set second [::assets::respond /css/styles.css {} text/css $b]
    list [dict get $second statusCode] [expr {[dict get $first headers ETag] eq [dict get $second headers ETag]}] \
        [expr {[binary decode base64 [dict get $second body]] eq $b}]
} -result {200 1 1}

test assets-layouts {Site and package-rendered layouts resolve the manifest} -body {
    set results {}
    foreach path {/ /packages /docs /docs/getting-started /blog /request-monitor} {
        set response [request $path]
        set html [dict get $response body]
        lappend results [expr {[string first [::assets::url /css/site.css] $html] >= 0}]
        lappend results [string match {*rel="icon" href="/assets/favicon.svg"*} $html]
        lappend results [string match {*rel="icon" href="/favicon.ico"*} $html]
        lappend results [expr {![regexp {(href|src)="/(css|js)/} $html]}]
        foreach {match url} [regexp -all -inline {(?:href|src)="(/assets/versioned/[^"]+)"} $html] {
            lappend results [expr {[dict get [request $url] statusCode] == 200}]
        }
    }
    lappend results [expr {[string first [::assets::url /js/chart.umd.js] \
        [dict get [request /request-monitor] body]] >= 0}]
    lsort -unique $results
} -result 1

test assets-html {Host HTML revalidates and package no-store policies are preserved} -body {
    list [dict get [request /] headers Cache-Control] [dict get [request /docs] headers cache-control]
} -result {no-cache no-store}

test assets-manifest {Startup requires a manifest but does not check referenced asset files} -setup {
    set fixture [makeDirectory assets-fixture]
    file mkdir $fixture/public/assets/versioned/css
    set saved_manifest $::assets::manifest
} -body {
    set missing [catch {::assets::load $fixture}]
    set channel [open $fixture/public/asset-manifest.json w]
    puts $channel {{"/css/test.css":"/assets/versioned/css/test.0000000000000000.css"}}
    close $channel
    set absent [catch {::assets::load $fixture}]
    set channel [open $fixture/public/assets/versioned/css/test.0000000000000000.css w]
    puts $channel {corrupted bytes}
    close $channel
    list $missing $absent [catch {::assets::load $fixture}]
} -cleanup {
    set ::assets::manifest $saved_manifest
    removeDirectory assets-fixture
} -result {1 0 0}

test bundles-layout {The homepage loads one combined stylesheet and script} -body {
    set html [dict get [request /] body]
    list [regexp -all {<link rel="stylesheet"} $html] [regexp -all {<script } $html] \
        [expr {[string first [::assets::url /js/site.js] $html] >= 0}]
} -result {1 1 1}

test compression-assets {gzip preserves exact bytes and uses a distinct, stable ETag} -body {
    set path [::assets::url /css/site.css]
    set plain [request $path]
    set zipped [request $path GET {Accept-Encoding gzip}]
    set again [request $path GET {accept-encoding gzip}]
    set bytes [::responses::bytes $zipped]
    list [dict get $zipped headers Content-Encoding] [dict get $zipped headers Vary] \
        [expr {[zlib gunzip $bytes] eq [::responses::bytes $plain]}] \
        [expr {[string length $bytes] < [string length [::responses::bytes $plain]]}] \
        [expr {[dict get $zipped headers ETag] eq "[string range [dict get $plain headers ETag] 0 end-1]-gzip\""}] \
        [expr {$zipped eq $again}]
} -result {gzip Accept-Encoding 1 1 1 1}

test compression-conditional {Validators select the negotiated representation for GET and HEAD} -body {
    set path [::assets::url /js/site.js]
    set get [request $path GET {accept-encoding gzip}]
    set etag [dict get $get headers ETag]
    set head [request $path HEAD {accept-encoding gzip}]
    set headers [dict create accept-encoding gzip if-none-match W/$etag]
    set unchanged [request $path GET $headers]
    set unchanged_head [request $path HEAD $headers]
    list [dict get $head body] [expr {[dict get $head headers] eq [dict get $get headers]}] \
        [dict get $unchanged statusCode] [dict get $unchanged body] [dict get $unchanged headers Vary] \
        [dict get $unchanged_head statusCode] [dict get $unchanged_head body] \
        [dict get [request $path GET [dict create if-none-match $etag]] statusCode]
} -result {{} 1 304 {} Accept-Encoding 304 {} 200}

test compression-negotiation {Quality values, exclusions, wildcards and identity are respected} -body {
    set result {}
    foreach value [list {} br gzip {br, gzip;q=0.5} {gzip;q=0} {*;q=1} \
            {gzip;q=0, *;q=1} {gzip;q=0.5, identity;q=1} {GZIP; Q=1.000} {gzip;q=invalid} {gzip;q=0.000}] {
        set response [request /css/site.css GET [dict create Accept-Encoding $value]]
        lappend result [dict exists $response headers Content-Encoding]
    }
    set result
} -result {0 0 1 1 0 1 0 0 1 0 0}

test compression-html {HTML is compressed after rendering and preserves UTF-8 text} -body {
    set plain [request /]
    set zipped [request / GET {accept-encoding gzip}]
    list [dict get $zipped headers Content-Encoding] [dict get $zipped headers Cache-Control] \
        [expr {[zlib gunzip [::responses::bytes $zipped]] eq [encoding convertto utf-8 [dict get $plain body]]}]
} -result {gzip no-cache 1}

test compression-skip {Small, binary, already encoded, partial and no-transform responses stay untouched} -body {
    set small [::twebserver::build_response 200 text/plain hello]
    set binary [::twebserver::build_response 200 image/png [string repeat x 2048]]
    set encoded [::twebserver::build_response 200 text/plain [string repeat x 2048]]
    dict set encoded headers Content-Encoding br
    set partial [::twebserver::build_response 206 text/plain [string repeat x 2048]]
    set no_transform [::twebserver::build_response 200 text/plain [string repeat x 2048]]
    dict set no_transform headers Cache-Control {public, no-transform}
    set result {}
    foreach response [list $small $binary $encoded $partial $no_transform] {
        set prepared [::responses::prepare {method GET headers {accept-encoding gzip}} $response]
        lappend result [expr {[dict get $prepared body] eq [dict get $response body]}]
    }
    set result
} -result {1 1 1 1 1}

test compression-vary {Compression preserves existing Vary fields} -body {
    set response [::twebserver::build_response 200 application/json [string repeat x 2048]]
    dict set response headers vary Origin
    set result [::responses::prepare {method GET headers {accept-encoding gzip}} $response]
    list [dict get $result headers Vary] [dict get $result headers Content-Encoding]
} -result {{Origin, Accept-Encoding} gzip}

test canonical-host {Other hosts redirect to HTTPS ttrek.sh with path and query intact} -setup {
    set saved_env [array get ::env ENV]
    set ::env(ENV) PROD
} -body {
    set response [::site::dispatch $::site::router {method GET path /search \
        queryString {q=web%20server&tag=a&tag=b} headers {Host www.ttrek.sh}}]
    list [dict get $response statusCode] [::responses::header $response Location] \
        [dict get $response headers Cache-Control] \
        [dict get [request / GET {host TTREK.SH x-forwarded-host evil.example}] statusCode]
} -cleanup {
    unset ::env(ENV)
    array set ::env $saved_env
} -result {302 https://ttrek.sh/search?q=web%20server&tag=a&tag=b no-store 200}

test canonical-host-local {LOCAL keeps localhost available} -setup {
    set saved_env [array get ::env ENV]
    set ::env(ENV) LOCAL
} -body {
    dict get [request / GET {host localhost:8080}] statusCode
} -cleanup {
    unset ::env(ENV)
    array set ::env $saved_env
} -result 200


namespace eval ::site_image_test {}
proc ::site_image_test::client {method bucket key args} {
    lappend ::site_image_test::calls [list $method $bucket $key {*}$args]
    if {$method eq "ls"} {return [dict keys $::site_image_test::objects $key]}
    dict set ::site_image_test::objects $key 1
}
test static-images-config {the default image directory serves both mounts and stays hidden in doc navigation} -setup {
    set savedImageEnv [array get ::env ENV]
    set ::env(ENV) LOCAL
    set imageRoot [makeDirectory static-image-site]
    foreach name {www public etc tcl} {file link -symbolic [file join $imageRoot $name] [file join $root $name]}
    file mkdir [file join $imageRoot content docs images] [file join $imageRoot content blog]
    foreach name {docs/guide.md blog/2026-11-11-guide.md} {
        set channel [open [file join $imageRoot content $name] w]
        puts $channel "# Guide\n\n!\[Image\](images/pixel.png)"
        close $channel
    }
    set channel [open [file join $imageRoot content docs images pixel.png] wb]
    puts -nonewline $channel [binary format H* 89504e470d0a00ff]
    close $channel
    set savedClients $::content_images::clients
    set ::content_images::clients [dict create {region eu-central-1} ::site_image_test::client]
    set ::site_image_test::calls {}
    set ::site_image_test::objects {}
    rename ::aws::s3::generate_presigned_url ::site_image_test::real_sign
    proc ::aws::s3::generate_presigned_url {args} {
        return "https://[lindex $args end-1].example/[lindex $args end]?X-Amz-Signature=[string repeat a 64]"
    }
    set imageRouter [::tpathexp::router]
} -body {
    set imageSettings [::app_config::content_images {content_images {bucket configured-images \
        region eu-central-1 prefix configured-prefix}} $imageRoot]
    ::site::configure [dict replace $settings rootdir $imageRoot content_images $imageSettings]
    foreach {kind directory} {wiki docs blog blog} {
        set store [dict get [::content_images::database_stores $::telemetry::connection $imageSettings] $kind]
        ::web::static::${kind}::sync $store [file join $imageRoot content $directory]
    }
    ::site::mount $imageRouter
    set result {}
    foreach path {/docs/guide /blog/2026-11-11-guide} {
        set response [$imageRouter dispatch [dict create method GET path $path]]
        lappend result [dict get $response statusCode] \
            [string match {*<img src="https://configured-images.example/configured-prefix/*} [dict get $response body]]
    }
    lappend result [dict size $::site_image_test::objects] \
        [llength [lsearch -all -index 0 $::site_image_test::calls put]] \
        [string match {*href="/docs/images"*} [dict get [$imageRouter dispatch {method GET path /docs}] body]]
    set result
} -cleanup {
    $imageRouter destroy
    rename ::aws::s3::generate_presigned_url {}
    rename ::site_image_test::real_sign ::aws::s3::generate_presigned_url
    set ::content_images::clients $savedClients
    ::site::configure $settings
    unset ::env(ENV)
    array set ::env $savedImageEnv
    removeDirectory static-image-site
} -result {200 1 200 1 1 1 0}

$::site::router destroy
set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
