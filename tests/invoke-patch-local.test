package require tcltest 2
namespace import ::tcltest::*
set root [file dirname [file dirname [file normalize [info script]]]]
source [file join $root bin invoke-patch-local.tcl]
rename ::trequests::request ::trequests::real_request
# Provide the request test fixture.
proc ::trequests::request {method url args} {
    set ::invocation [list $method $url $args]
    if {[info exists ::bootstrap_tasks]} {
        set task [dict get [::tjson::json_to_simple [dict get $args -data_binary]] task]
        lappend ::bootstrap_tasks $task
        set ::response_headers {}
        set ::response_body [::tjson::typed_to_json [list M [dict create ok {BOOL 1} task [list S $task] completed {L {}}]]]
        if {[info exists ::bootstrap_failure] && $task eq $::bootstrap_failure} {
            set ::response_headers {X-Amz-Function-Error Unhandled}
            set ::response_body {Task failed}
        }
    }
    return ::patch_response
}
# Provide the patch response test fixture.
proc ::patch_response {method} {
    switch $method {
        status_code {return $::http_status}
        headers {return $::response_headers}
        content {return $::response_body}
        error {return {connection refused}}
        destroy {incr ::destroyed}
    }
}
# Provide the reset response test fixture.
proc reset_response {} {
    set ::http_status 200
    set ::response_headers {}
    set ::response_body {{"ok":true,"task":"task_initdb_website","completed":[]}}
    set ::destroyed 0
    unset -nocomplain ::invocation
}

test local-patch-invoke {Direct loopback invocation uses the private payload and validates completion} -setup reset_response -body {
    set result [::local_patch::main $root {task_initdb_website --lambda-port 3101}]
    lassign $invocation method url options
    list $method $url [::tjson::json_to_simple [dict get $options -data_binary]] \
        [dict get [::tjson::json_to_simple $result] ok] $destroyed
} -result {POST http://127.0.0.1:3101/2015-03-31/functions/prod-Api-TtrekWebsite-Function/invocations {source ttrek.patch task task_initdb_website} 1 1}

test local-patch-function-error {HTTP 200 with a Lambda function error fails the script} -setup reset_response -body {
    set response_headers {X-Amz-Function-Error Unhandled}
    set failed [catch {::local_patch::invoke task_initdb_website 3001 test} message]
    list $failed [string match {Local Lambda task failed:*} $message] $destroyed
} -result {1 1 1}

test local-patch-http-error {HTTP and transport failures cannot look like completed tasks} -setup reset_response -body {
    set http_status 0
    set failed [catch {::local_patch::invoke task_initdb_website 3001 test} message]
    list $failed [string match {*connection refused*} $message] $destroyed
} -result {1 1 1}

test local-patch-confirmation {Missing, mismatched and malformed confirmations fail and release responses} -setup reset_response -body {
    set results {}
    foreach response_body [list {{"ok":false,"task":"task_initdb_website"}} \
        {{"ok":true,"task":"task_sync_website"}} {{"statusCode":200}} invalid] {
        lappend results [catch {::local_patch::invoke task_initdb_website 3001 test}]
    }
    list $results $destroyed
} -result {{1 1 1 1} 4}

test local-patch-validation {Invalid tasks, ports and options fail before making a request} -setup reset_response -body {
    list [catch {::local_patch::main $root {exec}}] \
        [catch {::local_patch::main $root {task_sync_website --lambda-port 0}}] \
        [catch {::local_patch::main $root {task_sync_website --endpoint https://example.org}}] \
        [info exists invocation]
} -result {1 1 1 0}

test local-patch-maintenance-scripts {The local tracker and pruning scripts invoke the matching private tasks} -setup reset_response -body {
    set channel [open [file join $root ttrek.json]]
    try {set scripts [dict get [::tjson::json_to_simple [read $channel]] scripts]} finally {close $channel}
    set results {}
    foreach {script task} {
        refresh-package-tracker-local task_refresh_package_tracker
        sync-access-local task_sync_access
        prune-accounts-local task_prune_accounts
        prune-accounts task_prune_accounts
    } {
        set definition [dict get $scripts $script]
        set response_body [::tjson::typed_to_json [list M [dict create ok {BOOL 1} task [list S $task] completed {L {}}]]]
        ::local_patch::main $root [dict get $definition args]
        set payload [::tjson::json_to_simple [dict get [lindex $invocation 2] -data_binary]]
        lappend results [expr {[dict get $definition file] eq "bin/invoke-patch-local.sh" && [dict get $payload task] eq $task}]
    }
    set results
} -result {1 1 1 1}

test local-patch-bootstrap {Bootstrap runs schema, access, content and tracker tasks in order through the configured local endpoint} -setup {
    reset_response
    set bootstrap_tasks {}
} -body {
    set channel [open [file join $root ttrek.json]]
    try {set definition [dict get [::tjson::json_to_simple [read $channel]] scripts bootstrap-local]} finally {close $channel}
    set result [::local_patch::main $root [concat [dict get $definition args] {--lambda-port 3101}]]
    list [dict get $definition file] $bootstrap_tasks \
        [lmap response [split $result \n] {dict get [::tjson::json_to_simple $response] task}] \
        [lindex $invocation 1] $destroyed
} -cleanup {unset bootstrap_tasks} -result {bin/invoke-patch-local.sh {task_initdb_website task_sync_access task_sync_website task_refresh_package_tracker} {task_initdb_website task_sync_access task_sync_website task_refresh_package_tracker} http://127.0.0.1:3101/2015-03-31/functions/prod-Api-TtrekWebsite-Function/invocations 4}

test local-patch-bootstrap-failure {A failed bootstrap step prevents subsequent tasks from running} -body {
    set results {}
    foreach bootstrap_failure {task_initdb_website task_sync_access task_sync_website task_refresh_package_tracker} {
        reset_response
        set bootstrap_tasks {}
        set failed [catch {::local_patch::main $root {bootstrap-local}} message]
        lappend results [list $failed $bootstrap_tasks $destroyed [string match {Local Lambda task failed:*} $message]]
    }
    set results
} -cleanup {unset bootstrap_tasks bootstrap_failure} -result {{1 task_initdb_website 1 1} {1 {task_initdb_website task_sync_access} 2 1} {1 {task_initdb_website task_sync_access task_sync_website} 3 1} {1 {task_initdb_website task_sync_access task_sync_website task_refresh_package_tracker} 4 1}}

rename ::trequests::request {}
rename ::trequests::real_request ::trequests::request
set failed $::tcltest::numTests(Failed)
cleanupTests
exit [expr {$failed > 0}]
