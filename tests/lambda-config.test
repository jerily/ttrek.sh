package require tcltest 2
package require tconfig::decrypt
namespace import ::tcltest::test
set sourceRoot [file dirname [file dirname [file normalize [info script]]]]
source [file join [file dirname [info script]] .. tcl config.tcl]
source [file join [file dirname [info script]] .. tcl local-ratelimit.tcl]
set saved_env [array get ::env]
set root [::tcltest::makeDirectory lambda-config-fixture]
file mkdir [file join $root etc]
set prod [file join $root etc config.ini]

test lambda-config-1 {Production fails closed without an encrypted password} -body {
    ::tconfig::write_config {tconfig {tink_keyset dummy} redis {host cache.example password plaintext}} $prod
    ::app_config::validate_lambda_config $prod
} -returnCodes error -match glob -result {*redis.enc:password*}

test lambda-config-2 {Plaintext password alongside ciphertext is rejected} -body {
    ::tconfig::write_config {tconfig {tink_keyset dummy} redis {host cache.example enc:password dummy password plaintext} postgres {host db.example database test username test enc:password dummy}} $prod
    ::app_config::validate_lambda_config $prod
} -returnCodes error -match glob -result {*plaintext passwords*}

test lambda-config-3 {Encrypted input is accepted without making a KMS call} -body {
    ::tconfig::write_config {tconfig {tink_keyset dummy} redis {host cache.example enc:password dummy} postgres {host db.example database test username test enc:password dummy}} $prod
    ::app_config::validate_lambda_config $prod
} -result {}

test lambda-config-postgres-1 {Production rejects missing PostgreSQL credentials} -body {
    ::tconfig::write_config {tconfig {tink_keyset dummy} redis {host cache.example enc:password dummy}} $prod
    ::app_config::validate_lambda_config $prod
} -returnCodes error -match glob -result {*postgres.enc:password*}

test lambda-config-postgres-2 {Production rejects plaintext PostgreSQL credentials} -body {
    ::tconfig::write_config {tconfig {tink_keyset dummy} redis {host cache.example enc:password dummy} \
        postgres {host db.example database test username test enc:password dummy password plaintext}} $prod
    ::app_config::validate_lambda_config $prod
} -returnCodes error -match glob -result {*plaintext passwords*}

test lambda-config-4 {Local mode ignores bundled production config and uses the selected local INI} -body {
    set ::env(ENV) LOCAL
    set ::env(TTREK_LOCAL_CONFIG) [file join $root etc config.local.ini]
    ::tconfig::write_config {ratelimit {limit 2 window_millis 1000}} $::env(TTREK_LOCAL_CONFIG)
    set settings [::app_config::lambda_middleware [::app_config::lambda_config $root]]
    list [dict keys [dict get $settings tratelimit store]] [dict keys [dict get $settings treqmon store]] \
        [dict get $settings tratelimit global_limits by_ip limit]
} -result {localstore tsvstore 2}

test lambda-config-5 {Production requires authenticated TLS for both shared stores} -body {
    set ::env(ENV) PROD
    set settings [::app_config::lambda_middleware {redis {host cache.example port 6379 password dummy ssl false}}]
    set rate [dict get $settings tratelimit store valkeystore]
    set monitor [dict get $settings treqmon store valkeystore]
    list [dict get $rate ssl] [dict get $monitor ssl] [dict get $rate host] [dict get $monitor host]
} -result {true true cache.example cache.example}

test lambda-config-6 {Invalid local limits fail before serving requests} -body {
    set ::env(ENV) LOCAL
    ::app_config::lambda_middleware {ratelimit {limit 0}}
} -returnCodes error -result {ratelimit.limit must be a positive integer}

test lambda-config-7 {Local store counts simultaneous requests and expires the old window} -body {
    ::tratelimit::middleware::localstore::init {}
    ::tratelimit::middleware::localstore::add_request test 0 100
    ::tratelimit::middleware::localstore::add_request test 0 100
    list [::tratelimit::middleware::localstore::get_requests_made test 0 200] \
        [::tratelimit::middleware::localstore::get_requests_made test 101 200]
} -result {2 0}

test lambda-config-8 {Monitor layout comes from the selected INI with a shared-site default} -body {
    set ::env(ENV) LOCAL
    set ::env(TTREK_LOCAL_CONFIG) [file join $root etc config.local.ini]
    ::tconfig::write_config {request_monitor {master_template custom-master.html.jinja}} $::env(TTREK_LOCAL_CONFIG)
    list [dict get [::app_config::request_monitor [::app_config::lambda_config $root]] master_template] \
        [dict get [::app_config::request_monitor {}] master_template]
} -result {custom-master.html.jinja request-monitor-master.html.jinja}

test lambda-config-9 {Local memory monitoring needs no Valkey settings and honors history limits} -body {
    set ::env(ENV) LOCAL
    ::app_config::monitor_store {request_monitor {store memory history_max_events 42}}
} -result {tsvstore {history_max_events 42}}

test lambda-config-10 {An explicit local Valkey monitor receives INI connection details} -body {
    set ::env(ENV) LOCAL
    set store [::app_config::monitor_store {request_monitor {store valkey history_max_events 37} \
        redis {host localhost port 6380 ssl true username monitor password test ssl_ca_file ca.pem timeout 1234}}]
    set settings [dict get $store valkeystore]
    list [dict get $settings host] [dict get $settings port] [dict get $settings ssl] \
        [dict get $settings username] [dict get $settings password] [dict get $settings ssl_ca_file] \
        [dict get $settings timeout] [dict get $settings history_max_events]
} -result {localhost 6380 true monitor test ca.pem 1234 37}

test lambda-config-11 {Invalid monitor store selection fails during configuration} -body {
    ::app_config::monitor_store {request_monitor {store unknown}}
} -returnCodes error -result {request_monitor.store must be memory or valkey}

test lambda-config-12 {Invalid monitor history limits fail during configuration} -body {
    ::app_config::monitor_store {request_monitor {store memory history_max_events 0}}
} -returnCodes error -result {request_monitor.history_max_events must be a positive integer}

# Run the real Lambda initializer with disposable configuration. Only KMS
# decryption, database connections and router startup are replaced.
file mkdir [file join $root tcl]
foreach name {config local-ratelimit patch} {
    file copy [file join $sourceRoot tcl $name.tcl] [file join $root tcl $name.tcl]
}
foreach {name script} {
    site {
        namespace eval ::site {variable router test_router}
        proc ::site::init_worker {config} {variable settings $config}
        proc ::site::config {} {variable settings; return $settings}
    }
    telemetry {
        namespace eval ::telemetry {}
        proc ::telemetry::init_local {settings registryDirectories} {set ::telemetry::registries $registryDirectories}
        proc ::telemetry::connect {settings} {set ::telemetry::connection test; set ::telemetry::registries {}}
    }
    telemetry-maintenance {}
    local-assets {}
} {
    set channel [open [file join $root tcl $name.tcl] w]
    puts $channel $script
    close $channel
}
file copy [file join $sourceRoot tests fixtures release-checksums.json] [file join $root etc releases.json]
set config [::tconfig::read_config [file join $sourceRoot devops config.prod.ini]]
dict set config tconfig tink_keyset dummy
foreach section {redis postgres} {
    dict set config $section host "$section.example"
    dict unset config $section password
    dict set config $section enc:password dummy
}
::tconfig::write_config $config $prod
rename ::tconfig::load_config ::tconfig::real_load_config
proc ::tconfig::load_config {path} {
    set config [read_config $path]
    foreach section {redis postgres} {dict set config $section password dummy}
    return $config
}
source [file join $sourceRoot tcl lambda.tcl]
source [file join $sourceRoot tcl releases.tcl]

test lambda-releases-1 {Production startup loads releases and resolves the manifest from the application root} -setup {
    set ::env(ENV) PROD
    unset -nocomplain ::env(TTREK_LOCAL_S3_ENDPOINT)
    set ::releases::client [::aws::s3::create {region eu-central-1 aws_access_key_id test aws_secret_access_key test}]
} -body {
    ::site_lambda::initialize $root
    if {$::telemetry::registries ne {}} {error "PROD startup must not import registry metadata"}
    set releases [dict get [::site::config] releases]
    set artifact [::releases::artifact aarch64-apple-darwin]
    set url [::releases::signed_url $artifact]
    list [dict get $releases bucket] [dict get $releases version] \
        [expr {[dict get $releases checksums_file] eq [file join $root etc releases.json]}] \
        [expr {[dict get $releases checksums $artifact] eq [string repeat c 64]}] \
        [string match {https://jerily-ttrek-app.s3.eu-central-1.amazonaws.com/ttrek/1.2.0/macos-arm64/ttrek?*} $url] \
        [regexp {[?&]X-Amz-Signature=[0-9a-f]{64}(&|$)} $url]
} -cleanup {
    ::aws::s3::destroy $::releases::client
    set ::releases::client {}
} -result {jerily-ttrek-app 1.2.0 1 1 1 1}

test lambda-releases-2 {Local mock release overrides remain independent of the production configuration} -body {
    set ::env(ENV) LOCAL
    set ::env(TTREK_LOCAL_CONFIG) [file join $root etc config.local.ini]
    ::tconfig::write_config {} $::env(TTREK_LOCAL_CONFIG)
    set ::env(TTREK_LOCAL_S3_ENDPOINT) http://127.0.0.1:9999
    set ::env(TTREK_LOCAL_RELEASES) [dict create prefix test/2.0.0 version 2.0.0 \
        checksums [dict create linux-amd64-glibc [string repeat b 64]]]
    ::site_lambda::initialize $root
    set releases [dict get [::site::config] releases]
    list [dict get $releases bucket] [dict get $releases version] [dict get $releases prefix] \
        [dict get $releases endpoint] \
        [expr {[dict get $releases checksums linux-amd64-glibc] eq [string repeat b 64]}]
} -result {ttrek-local 2.0.0 test/2.0.0 http://127.0.0.1:9999 1}

test lambda-registry-metadata {Lambda imports metadata from its bundled registry} -body {
    set ::telemetry::registries
} -result [list [file join $root registry]]

rename ::tconfig::load_config {}
rename ::tconfig::real_load_config ::tconfig::load_config
array unset ::env
array set ::env $saved_env
::tcltest::removeDirectory $root
set failed $::tcltest::numTests(Failed)
::tcltest::cleanupTests
exit [expr {$failed > 0}]
