# Copy to etc/config.local.ini (gitignored). Local Lambda mocks use memory stores.
[ratelimit]
window_millis=10000
limit=1000

[request_monitor]
store=memory
master_template=request-monitor-master.html.jinja
history_max_events=10000

[releases]
version=1.0.0
prefix=ttrek/1.0.0
checksums_file=etc/releases.json

[content_images]
# Sources are relative to this directory; paths cannot escape it.
directory=content
bucket=
region=us-east-1
prefix=ttrek/content/images
url_expiry_seconds=3600
