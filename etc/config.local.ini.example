# Copy to etc/config.local.ini (gitignored) and configure your running Valkey service.
[redis]
host=localhost
port=6379
ssl=false

[ratelimit]
window_millis=10000
limit=100

[request_monitor]
store=valkey
master_template=request-monitor-master.html.jinja
history_max_events=10000

[releases]
version=1.9.0
prefix=ttrek/1.9.0
checksums_file=etc/releases.json

[content_images]
# Sources are relative to this directory; paths cannot escape it.
docs_directory=content/docs
blog_directory=content/blog
bucket=
region=us-east-1
prefix=ttrek/content/images
# Browser assets (favicon, CSS and JS) use a separate S3 prefix.
assets_prefix=cdn
url_expiry_seconds=3600
# PROD only; SAM imports the CDN base URL from the CloudFront stack.
cloudfront_enabled=false

[account]
password_min_length=6
tenant=ttrek.sh
# Public site name for email subjects and authenticator apps.
issuer=ttrek.sh
registration_captcha=true
captcha_length=6
captcha_letters=true
login_captcha_after=3
login_captcha_window=900
cleanup_grace_period=3600
persistent_session_ttl=2592000
collect_names=true
collect_display_name=false
collect_username=false
email_verification_required=true
verification_emails_enabled=true
origin=http://localhost:8080
email_enabled=false
# Development keys are generated once in the local data directory.
