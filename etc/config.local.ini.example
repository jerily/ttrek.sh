# Copy to etc/config.local.ini (gitignored) and configure your running Valkey service.
[redis]
host=localhost
port=6379
ssl=false

[ratelimit]
window_millis=10000
limit=1000

[request_monitor]
store=valkey
master_template=request-monitor-master.html.jinja
history_max_events=10000

[releases]
version=1.3.0
prefix=ttrek/1.3.0
checksums_file=etc/releases.json

[content_images]
# Sources are relative to this directory; paths cannot escape it.
docs_directory=content/docs
blog_directory=content/blog
bucket=
region=us-east-1
prefix=ttrek/content/images
# Browser assets (favicon, CSS and JS) use a separate S3 prefix.
assets_prefix=cdn
url_expiry_seconds=3600
# PROD only; SAM imports the CDN base URL from the CloudFront stack.
cloudfront_enabled=false
