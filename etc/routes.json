{
  "lambdaEndpoint": "http://127.0.0.1:3001",
  "timeoutMs": 30000,
  "apiGateway": {
    "name": "ttrek-sh",
    "stage": "$default",
    "authorizer": {
      "function": "",
      "excludePaths": []
    }
  },
  "routes": [
    {"method": "ANY", "path": "/", "function": "prod-Api-TtrekWebsite-Function"},
    {"method": "ANY", "path": "/{proxy+}", "function": "prod-Api-TtrekWebsite-Function"}
  ]
}
