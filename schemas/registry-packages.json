{
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "names",
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[A-Za-z0-9._+-]+$"
              }
            },
            "mode": {
              "type": "string",
              "enum": [
                "versions",
                "exists"
              ]
            }
          }
        }
      }
    }
  }
}
