{
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": [
            "os",
            "arch",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9._+-]+$"
            },
            "arch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9._+-]+$"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "version",
                  "field"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[A-Za-z0-9._+-]+$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[A-Za-z0-9._+-]+$"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "languages",
                      "recipe"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
