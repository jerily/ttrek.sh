{
  "name": "thread",
  "version": "3.0.7",
  "scripts": {},
  "dependencies": {
    "tcl": "^9.1.0"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://prdownloads.sourceforge.net/tcl/thread3.0.7.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "configure",
        "options": [
          {
            "name": "with-tcl",
            "value": "$INSTALL_DIR/lib"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
