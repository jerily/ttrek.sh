{
  "name": "libvalkey",
  "version": "0.5.0",
  "scripts": {},
  "dependencies": {
    "openssl": "^3.0.13"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/valkey-io/libvalkey/archive/refs/tags/0.5.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "ENABLE_TLS",
            "value": "ON"
          },
          {
            "name": "DISABLE_TESTS",
            "value": "ON"
          },
          {
            "name": "BUILD_SHARED_LIBS",
            "value": "OFF",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
