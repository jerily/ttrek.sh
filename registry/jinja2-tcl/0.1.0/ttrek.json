{
  "name": "jinja2-tcl",
  "version": "0.1.0",
  "scripts": {},
  "dependencies": {
    "tcl": "^9.1.0",
    "cjson": "^1.7.19"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/jinja2-tcl/archive/refs/tags/v0.1.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_INSTALL_LIBDIR",
            "value": "lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "TCL_STUB_LIBRARY",
            "value": "$INSTALL_DIR/lib/libtclstub.a"
          },
          {
            "name": "TCL_TCLSH",
            "value": "$INSTALL_DIR/bin/tclsh9.1"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
