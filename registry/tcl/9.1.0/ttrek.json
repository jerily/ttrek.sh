{
  "name": "tcl",
  "version": "9.1.0",
  "scripts": {},
  "dependencies": {
    "zlib": "^1.3.1"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://prdownloads.sourceforge.net/tcl/tcl9.1.0-src.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "env_variable",
        "if": "+debug",
        "name": "CFLAGS",
        "value": "-DPURIFY"
      },
      {
        "cmd": "env_variable",
        "if": "+sanitize",
        "name": "CFLAGS",
        "value": "-fsanitize=address"
      },
      {
        "cmd": "env_variable",
        "if": "+sanitize",
        "name": "LDFLAGS",
        "value": "-fsanitize=address"
      },
      {
        "cmd": "env_variable",
        "if": "+sanitize",
        "name": "CFLAGS",
        "value": "-fsanitize=undefined"
      },
      {
        "cmd": "env_variable",
        "if": "+sanitize",
        "name": "LDFLAGS",
        "value": "-fsanitize=undefined"
      },
      {
        "cmd": "configure",
        "path": "$SOURCE_DIR/unix/configure",
        "options": [
          {
            "name": "enable-symbols",
            "value": "all",
            "if": "+debug"
          },
          {
            "name": "disable-shared",
            "if": "+static"
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install"
      }
    ]
  }
}
