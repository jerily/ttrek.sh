{
  "name": "openssl",
  "version": "3.5.9",
  "scripts": {},
  "dependencies": {},
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd",
        "dirname": "$SOURCE_DIR"
      },
      {
        "cmd": "configure",
        "path": "./Configure",
        "options": [
          {
            "name": "libdir",
            "value": "lib"
          },
          {
            "name": "no-shared",
            "if": "+static",
            "option_prefix": ""
          },
          {
            "name": "no-pinshared",
            "if": "+static",
            "option_prefix": ""
          },
          {
            "name": "no-tests",
            "option_prefix": ""
          }
        ]
      },
      {
        "cmd": "make",
        "parallel": true
      },
      {
        "cmd": "make_install",
        "target": "install_sw"
      }
    ]
  }
}
