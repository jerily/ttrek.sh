{
  "name": "tpathexp",
  "version": "1.0.0",
  "scripts": {},
  "dependencies": {
    "tcl": ">=8.6.14"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/tpathexp/releases/download/v1.0.0/tpathexp-1.0.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "cmake_config",
        "options": [
          {
            "name": "CMAKE_INSTALL_LIBDIR",
            "value": "lib"
          },
          {
            "name": "TCL_INCLUDE_PATH",
            "value": "$INSTALL_DIR/include"
          },
          {
            "name": "BUILD_TESTING",
            "value": "OFF"
          }
        ]
      },
      {
        "cmd": "cmake_make",
        "config": "Release",
        "parallel": true
      },
      {
        "cmd": "cmake_install",
        "config": "Release"
      }
    ]
  }
}
