{
  "name": "treqmon",
  "version": "2.0.0",
  "scripts": {},
  "dependencies": {
    "valkey-tcl": ">=1.0.1",
    "twebserver": ">=1.47.53",
    "jinja2-tcl": "^0.1.0",
    "tjson": ">=1.0.26",
    "thread": ">=2.8.9"
  },
  "devDependencies": {},
  "build": {
    "default": [
      {
        "cmd": "download",
        "url": "https://github.com/jerily/treqmon/archive/refs/tags/v2.0.0.tar.gz"
      },
      {
        "cmd": "unpack"
      },
      {
        "cmd": "cd"
      },
      {
        "cmd": "make_install",
        "options": [
          {
            "name": "PREFIX",
            "value": "$INSTALL_DIR"
          }
        ]
      }
    ]
  }
}
