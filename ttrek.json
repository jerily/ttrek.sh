{
  "name": "ttrek_sh",
  "version": "1.0.0",
  "scripts": {
    "init-docs": "exec \"$PROJECT_HOME/bin/docs.sh\" init \"$@\"",
    "sync-docs": "exec \"$PROJECT_HOME/bin/docs.sh\" sync \"$@\"",
    "start-direct": "exec \"$PROJECT_HOME/run.sh\" \"$@\"",
    "package": "exec \"$PROJECT_HOME/bin/package-lambda.sh\" \"$@\"",
    "start-local": "exec \"$PROJECT_HOME/bin/start-local.sh\" \"$@\"",
    "start-lambda": "exec \"$PROJECT_HOME/bin/start-lambda.sh\" \"$@\"",
    "start-proxy": "exec \"$PROJECT_HOME/bin/start-proxy.sh\" \"$@\"",
    "start-s3": "exec \"$PROJECT_HOME/bin/start-s3.sh\" \"$@\"",
    "edit-direct": "exec \"$PROJECT_HOME/run.sh\" -authorize \"$@\"",
    "edit-local": "exec \"$PROJECT_HOME/bin/start-local.sh\" --edit \"$@\""
  },
  "dependencies": {
    "tcl": "^9.1.0",
    "jinja2-tcl": "^0.1.0",
    "thread": "^3.0.7",
    "tjson": "^1.0.26",
    "topenapi": "^0.2.0",
    "ttrie": "=0.1.1",
    "ttrigrams": "=0.1.0",
    "valkey-tcl": "^1.0.3",
    "tink-tcl": "^20240704.0.1",
    "aws-sdk-tcl": "^1.0.12",
    "tratelimit": "^1.0.1",
    "treqmon": "^2.0.0",
    "tsession": "^1.0.3",
    "tconfig": "^1.0.0",
    "tsession-dynamodb": "^1.0.0",
    "web-wiki": "^0.1.0",
    "tpathexp": "^1.1.0",
    "tpersist": "^0.1.0"
  },
  "devDependencies": {
    "twebserver": "^1.47.54",
    "mock-lambda-app": "^0.1.0",
    "mock-proxy-app": "^0.1.0",
    "mock-s3-app": "^0.1.0",
    "tcllib": "^2.0.0"
  }
}
