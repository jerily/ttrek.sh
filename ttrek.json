{
  "name": "ttrek_sh",
  "version": "1.0.0",
  "scripts": {
    "build-assets": "cd \"$PROJECT_HOME\" && npm ci --ignore-scripts && npm run build",
    "build-search": "exec \"$PROJECT_HOME/bin/build-search.sh\" \"$@\"",
    "start-direct": "exec \"$PROJECT_HOME/run.sh\" \"$@\"",
    "start-local": "exec \"$PROJECT_HOME/bin/start-local.sh\" \"$@\"",
    "start-lambda": "exec \"$PROJECT_HOME/bin/start-lambda.sh\" \"$@\"",
    "start-proxy": "exec \"$PROJECT_HOME/bin/start-proxy.sh\" \"$@\"",
    "start-s3": "exec \"$PROJECT_HOME/bin/start-s3.sh\" \"$@\"",
    "package-lambda": "exec \"$PROJECT_HOME/bin/package-lambda.sh\" \"$@\""
  },
  "dependencies": {
    "libpq": "^16.15.0",
    "tcl": "^9.1.0",
    "jinja2-tcl": "^0.1.0",
    "thread": "^3.0.7",
    "tink-tcl": "^20240704.0.1",
    "tjson": "^1.0.26",
    "topenapi": "^0.2.0",
    "tpathexp": "^1.1.0",
    "ttrie": "=0.2.0",
    "ttrigrams": "=0.2.0",
    "valkey-tcl": "^1.0.3",
    "tdbcpostgres": ">=1.1.8",
    "web-static-blog": "^0.1.0",
    "web-static-wiki": "^0.1.0",
    "tsession": "^1.0.3",
    "tratelimit": "^1.0.1",
    "treqmon": "^2.1.0",
    "aws-sdk-tcl-s3": "^1.0.14",
    "tpersist": "^0.1.0",
    "tsession-dynamodb": "^1.0.0",
    "tconfig": "^1.0.0"
  },
  "devDependencies": {
    "tcllib": "^2.0.0",
    "trequests": "^1.1.0",
    "twebserver": "^1.47.55",
    "tdevops": "^0.2.0"
  }
}